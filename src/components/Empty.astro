---
interface Props {
  id?: string;
  title?: string;
  description?: string;
  href?: string;
  action?: string;
}

const {
  id = "news-empty-title",
  title = "아직 모은 뉴스가 없어요",
  description = "다음 동기화가 끝나면 최신 큐레이션이 여기에 보여요.",
  href = "https://oiyo.net/ko/",
  action = "OIYO 둘러보기",
} = Astro.props;
---

<section data-slot="empty" class="empty-state" aria-labelledby={id}>
  <svg aria-hidden="true" class="empty-icon" viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10 10h24v28a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4V12a2 2 0 0 1 2-2z" />
    <path d="M34 18h4a2 2 0 0 1 2 2v18a4 4 0 0 1-8 0" />
    <path d="M14 17h14M14 23h14M14 29h9" opacity="0.55" />
  </svg>
  <h2 id={id}>{title}</h2>
  <p>{description}</p>
  <a href={href}>{action}</a>
</section>

<style>
  .empty-state { margin:18px 0;padding:28px 18px;text-align:center;border:1px dashed var(--border);border-radius:14px;background:var(--card) }
  .empty-icon { display:block;margin:0 auto;color:var(--accent) }
  h2 { margin:8px 0 4px;font-size:17px }
  p { margin:0 auto 14px;max-width:34rem;color:var(--muted);font-size:13.5px }
  a { display:inline-flex;min-height:44px;align-items:center;justify-content:center;border-radius:10px;background:var(--accent);color:#fff;padding:8px 16px;text-decoration:none;font-weight:750 }
  a:focus-visible { outline:2px solid var(--ink);outline-offset:3px }
</style>
