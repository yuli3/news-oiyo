---
import showcase from "../data/showcase-weekly.json";

interface FeaturedSeed {
  title: string;
  oneLiner: string;
  aiTools?: string[];
  url: string;
}

interface ShowcaseNewsCard {
  mode: "winner" | "open-call" | string;
  section: string;
  title?: string;
  oneLiner?: string;
  maker?: string;
  aiTools?: string[];
  headline?: string;
  summary?: string;
  showcaseUrl: string;
  submitUrl: string;
  featuredSeeds?: FeaturedSeed[];
}

const card = showcase.newsCard as ShowcaseNewsCard;
---

<section class="showcase-spotlight" aria-labelledby="showcase-heading">
  <div class="showcase-head">
    <span class="tag">{showcase.week}</span>
    <h2 id="showcase-heading">{card.section}</h2>
  </div>

  {card.mode === "winner" ? (
    <div class="card showcase-body">
      <p class="winner-title">
        <a href={card.showcaseUrl} target="_blank" rel="noopener noreferrer">{card.title}</a>
        <span class="maker"> · {card.maker}</span>
      </p>
      <p class="winner-summary">{card.oneLiner}</p>
      {card.aiTools && card.aiTools.length > 0 && (
        <p class="tools-meta">사용 AI: {card.aiTools.join(", ")}</p>
      )}
      <div class="showcase-actions">
        <a class="cta-link" href={card.showcaseUrl} target="_blank" rel="noopener noreferrer">작품 자세히 보기 →</a>
        <a class="sub-link" href={card.submitUrl} target="_blank" rel="noopener noreferrer">내 AI 작품 출품하기</a>
      </div>
    </div>
  ) : (
    <div class="card showcase-body">
      <p class="winner-title">{card.headline}</p>
      <p class="winner-summary">{card.summary}</p>
      {card.featuredSeeds && card.featuredSeeds.length > 0 && (
        <ul class="seed-list">
          {card.featuredSeeds.map((seed) => (
            <li>
              <a href={seed.url} target="_blank" rel="noopener noreferrer">{seed.title}</a>
              <span> — {seed.oneLiner}</span>
            </li>
          ))}
        </ul>
      )}
      <div class="showcase-actions">
        <a class="cta-link" href={card.submitUrl} target="_blank" rel="noopener noreferrer">내 AI 작품 출품하기 →</a>
        <a class="sub-link" href={card.showcaseUrl} target="_blank" rel="noopener noreferrer">쇼케이스 둘러보기</a>
      </div>
    </div>
  )}
</section>

<style>
  .showcase-spotlight {
    margin-top: 36px;
  }
  .showcase-head {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 6px;
    margin-bottom: 12px;
  }
  .showcase-head h2 {
    margin: 0;
    border: none;
    padding: 0;
    font-size: 20px;
  }
  .showcase-body {
    margin: 0;
  }
  .winner-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 800;
  }
  .maker {
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
  }
  .winner-summary {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 14px;
  }
  .tools-meta {
    margin: 0 0 10px;
    font-size: 13px;
    color: var(--ink);
  }
  .seed-list {
    margin: 0 0 12px;
    padding-left: 18px;
    font-size: 14px;
    color: var(--muted);
  }
  .seed-list li {
    margin: 4px 0;
  }
  .showcase-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  .cta-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-weight: 800;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sub-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
