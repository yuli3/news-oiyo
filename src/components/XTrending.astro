---
// 2026-10-14: "X에서 뜨는 AI 이야기" — Grok Bot이 x MCP로 모은 data/x-trending/<date>.json을
// 정적 카드로 보여 줘요(임베드 없음). 파일이 없는 날짜는 아무것도 그리지 않아요.
// 수집 규칙과 스키마: docs/x-trending.md
type XPost = {
  id: string;
  url: string;
  author: { username: string; name: string };
  created_at?: string;
  quote: string;
  topic?: string;
  summary_ko: string;
  link?: string | null;
};
type XDay = { date: string; collected_at?: string; posts: XPost[] };

interface Props { date: string }
const { date } = Astro.props;
const files = import.meta.glob<XDay>("../../data/x-trending/*.json", { eager: true, import: "default" });
const xday = Object.values(files).find((f) => f.date === date);
const posts = xday?.posts ?? [];
const xUrl = (p: XPost) => `https://x.com/${p.author.username}/status/${p.id}`;
---
{posts.length > 0 && (
  <section class="xt" aria-labelledby="xt-title">
    <h2 id="xt-title">X에서 뜨는 AI 이야기 <span class="xt-n">{posts.length}</span></h2>
    <p class="xt-note">지난 24시간 X에서 화제가 된 AI 게시물이에요. 인용은 원문 앞부분이고, 한국어 요약은 직접 썼어요. 게시물 속 주장은 따로 확인해 주세요.</p>
    <ul class="xt-list">
      {posts.map((p) => (
        <li class="xt-card">
          <div class="xt-head">
            <b>{p.author.name}</b> <span class="xt-h">@{p.author.username}</span>
            {p.topic && <span class="xt-topic">{p.topic}</span>}
          </div>
          <blockquote class="xt-q">{p.quote}</blockquote>
          <p class="xt-s">{p.summary_ko}</p>
          <div class="xt-links">
            <a href={xUrl(p)} rel="noopener nofollow" target="_blank">X에서 보기</a>
            {p.link && <a href={p.link} rel="noopener nofollow" target="_blank">링크된 글</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .xt { margin-top: 22px; }
  .xt h2 { font-size: 16px; margin: 0 0 4px; border-bottom: 2px solid var(--accent); padding-bottom: 4px; }
  .xt-n { font-size: 12px; color: var(--muted); font-weight: 400; }
  .xt-note { font-size: 12px; color: var(--muted); margin: 4px 0 10px; }
  .xt-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .xt-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; font-size: 13.5px; }
  .xt-head { font-size: 13px; }
  .xt-h { color: var(--muted); }
  .xt-topic { margin-left: 6px; font-size: 11.5px; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 0 6px; }
  .xt-q { margin: 6px 0; padding-left: 10px; border-left: 3px solid var(--border); color: #4a4c42; white-space: pre-line; }
  .xt-s { margin: 4px 0; }
  .xt-links { display: flex; gap: 12px; font-size: 12.5px; }
</style>
