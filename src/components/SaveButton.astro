---
interface Props { url: string; title: string; source?: string; date?: string }
const { url, title, source, date } = Astro.props;
---
<button type="button" class="save-btn" data-save-url={url} data-save-title={title} data-save-source={source} data-save-date={date} aria-pressed="false">저장</button>
<script>
  import { isSaved, toggleSaved } from "../lib/saved";
  function paint(b: HTMLButtonElement, on: boolean) {
    b.setAttribute("aria-pressed", String(on));
    b.textContent = on ? "저장했어요" : "저장";
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>("button[data-save-url]")) {
    if (b.dataset.bound) continue;
    b.dataset.bound = "1";
    paint(b, isSaved(b.dataset.saveUrl!));
    b.addEventListener("click", () => {
      const on = toggleSaved({ url: b.dataset.saveUrl!, title: b.dataset.saveTitle ?? b.dataset.saveUrl!, source: b.dataset.saveSource, date: b.dataset.saveDate });
      paint(b, on);
    });
  }
</script>
<style>
  .save-btn { font:inherit; font-size:12px; font-weight:650; color:var(--muted); background:none; border:1px solid var(--border); border-radius:999px; padding:2px 10px; min-height:28px; cursor:pointer; margin-left:6px }
  .save-btn:hover { color:var(--accent); border-color:var(--accent) }
  .save-btn[aria-pressed="true"] { color:var(--accent); border-color:var(--accent) }
  .save-btn:focus-visible { outline:2px solid var(--accent); outline-offset:2px }
</style>
