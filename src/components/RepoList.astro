---
// "오늘의 저장소" — GitHub Trending 저장소는 뉴스 흐름과 따로 보여 준다(2026-10-07).
// 점수는 누적 스타가 아니라 그날 받은 별(stars today)이다. 요약은 README 기반이며,
// 한국어 detailSummary 가 있을 때만 상세 링크를 단다.
import { hasDetailPage, type NewsItemRecord } from "../lib/feed";

interface Props {
  repos: NewsItemRecord[];
  /** 날짜 페이지면 그 날짜, 홈이면 최신 날짜. */
  date: string;
  heading?: string;
  headingLevel?: "h2" | "h3";
  /** 홈에서는 날짜 페이지로 이어 준다. */
  moreHref?: string;
}

const { repos, date, heading = "오늘의 저장소", headingLevel = "h2", moreHref } = Astro.props;
const Heading = headingLevel;
const repoName = (item: NewsItemRecord) => {
  try {
    return new URL(item.url).pathname.split("/").filter(Boolean).slice(0, 2).join("/") || item.title;
  } catch {
    return item.title;
  }
};
---
{repos.length > 0 && (
  <section class="repos" aria-labelledby={`repos-${date}`}>
    <div class="repos-head">
      <Heading id={`repos-${date}`}>{heading}</Heading>
      <span class="repos-meta">GitHub Trending · {date} · {repos.length}개</span>
    </div>
    <p class="repos-lede">그날 별을 많이 받은 AI 저장소예요. 요약은 저장소 README를 읽고 정리해요.</p>
    <ul class="repo-list">
      {repos.map((repo) => (
        <li class="repo" data-source="github">
          <a class="repo-name" href={repo.url} target="_blank" rel="noopener noreferrer">{repoName(repo)}</a>
          {repo.summary && <p class="repo-desc">{repo.summary}</p>}
          <p class="repo-meta">
            {repo.score != null && <>★ 오늘 {repo.score.toLocaleString("ko-KR")}</>}
            {hasDetailPage(repo) && (
              <>{repo.score != null && " · "}<a class="repo-detail" href={`/item/${repo.id}/`}>README 요약 읽기</a></>
            )}
          </p>
        </li>
      ))}
    </ul>
    {moreHref && <p class="repos-more"><a href={moreHref}>{date} 전체 보기</a></p>}
  </section>
)}

<style>
  .repos { margin: 24px 0 8px; }
  .repos-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; border-bottom: 2px solid var(--accent); padding-bottom: 6px; margin-bottom: 8px; }
  .repos-head h2, .repos-head h3 { font-size: 18px; margin: 0; }
  .repos-meta { font-size: 12px; color: var(--muted); }
  .repos-lede { margin: 0 0 10px; font-size: 13px; color: var(--muted); }
  .repo-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .repo { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; min-width: 0; }
  .repo-name { color: var(--ink); font-weight: 700; text-decoration: none; overflow-wrap: anywhere; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; }
  .repo-name:hover { color: var(--accent); }
  .repo-name:focus-visible, .repo-detail:focus-visible, .repos-more a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }
  .repo-desc { margin: 6px 0 0; font-size: 13px; line-height: 1.5; color: var(--ink); overflow-wrap: anywhere; }
  .repo-meta { margin: 6px 0 0; font-size: 12px; color: var(--muted); }
  .repo-detail { color: var(--muted); font-weight: 650; text-decoration: underline; text-underline-offset: 2px; }
  .repo-detail:hover { color: var(--accent); }
  .repos-more { margin: 10px 0 0; font-size: 13px; }
  .repos-more a { color: var(--accent); font-weight: 650; }
</style>
