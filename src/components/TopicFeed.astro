---
import NewsItem from "./NewsItem.astro";
import { displayTitle, hasDetailPage, SOURCE_COLOR, type FeedItem } from "../lib/feed";
interface Props { items: FeedItem[]; label: string; filters?: boolean; desk?: "ai" | "finance" }
const { items, label, filters = false, desk = "ai" } = Astro.props;
// 2026-11-22: 금융 목록에도 HN·Reddit 칩이 나왔다. 분야별 칩을 쓰고, 현재 목록에 하나도 없는 칩은 숨긴다.
const SOURCES: Record<string, string[]> = {
  hn:["hacker-news","hn"],geeknews:["geeknews"],reddit:["reddit"],official:["openai-news","openai","deepmind-blog","deepmind","karpathy-blog","karpathy","google-developers","googledev","nvidia-developer","nvidiadev"],kr:["aitimes","zdnet-kr","ai타임스","지디넷"],
  krpress:["hankyung-finance","mk-economy","hankyung-realestate","aitimes","zdnet-kr"],global:["cnbc-finance","yahoo-finance","techcrunch","coindesk"],policy:["federal-reserve","sec","moef","bok"],realestate:["hankyung-realestate"],crypto:["coindesk"],
};
const CHIPS: Record<string, [string, string][]> = {
  ai: [["hn","HN"],["geeknews","GeekNews"],["reddit","Reddit"],["official","공식"],["kr","한국"]],
  finance: [["krpress","국내 경제지"],["global","해외"],["policy","정책·공식 발표"],["realestate","부동산"],["crypto","크립토"]],
};
const srcOf = (it: FeedItem) => (it.src || "").toLowerCase();
const chips = [["all","전체"] as [string,string], ...CHIPS[desk].filter(([key]) => items.some((it) => SOURCES[key].includes(srcOf(it))))];
const entries = items.map((it,index) => ({ "@type":"ListItem",name:displayTitle(it),position:index+1,url:hasDetailPage(it)?new URL(`/item/${it.id}/`,Astro.site).href:it.url }));
---
<div data-topic-feed>
  {filters && items.length > 0 && <div class="source-chips" role="group" aria-label={`${label} 출처 필터`} data-sources={JSON.stringify(SOURCES)}>
    {chips.map(([key,name]) => <button type="button" data-filter={key} aria-pressed={key==="all"?"true":"false"}>{name}</button>)}
  </div>}
  <p data-filter-empty hidden>이 출처의 항목은 현재 목록에 없어요. 다른 출처나 날짜별 목록을 확인해 주세요.</p>
  {items.length===0 ? <p>이 분야에서 아직 표시할 기사가 없어요. <a href="/archive/">날짜별 기사</a>를 둘러보세요.</p> :
    <ol class="news-board" aria-label={label}>{items.map(it => <NewsItem {...it} href={it.url} source={it.src} sourceColor={SOURCE_COLOR[it.src]} itemId={hasDetailPage(it)?it.id:undefined} />)}</ol>}
  {entries.length>0 && <script is:inline type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"ItemList",name:label,itemListElement:entries})} />}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-topic-feed]").forEach(feed => {
    const sources: Record<string,string[]> = JSON.parse(feed.querySelector<HTMLElement>("[data-sources]")?.dataset.sources || "{}");
    const buttons=feed.querySelectorAll<HTMLButtonElement>("button[data-filter]");
    buttons.forEach(button=>button.addEventListener("click",()=>{
      const key=button.dataset.filter||"all";let visible=0;
      feed.querySelectorAll<HTMLElement>(".news-board > li[data-source]").forEach(item=>{
        const show=key==="all"||(sources[key]||[]).includes((item.dataset.source||"").toLowerCase());item.hidden=!show;if(show)visible++;
      });
      const empty=feed.querySelector<HTMLElement>("[data-filter-empty]");if(empty)empty.hidden=visible>0;
      buttons.forEach(control=>control.setAttribute("aria-pressed",String(control===button)));
    }));
  });
</script>
<style>
  .news-board{list-style:none;margin:8px 0 0;padding:0;border-top:1px solid var(--border)}.source-chips{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
  /* 2026-11-22: 좁은 화면에서는 칩이 두 줄로 밀려 첫 기사가 내려갔다. 한 줄 가로 스크롤로 둔다. */
  @media(max-width:640px){.source-chips{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin-inline:-14px;padding:2px 14px}.source-chips::-webkit-scrollbar{display:none}.source-chips button{flex:none}}
  button{min-height:44px;padding:8px 14px;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--ink);font:inherit;font-size:13px;cursor:pointer}
  button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}[data-filter-empty]{color:var(--muted)}
</style>
