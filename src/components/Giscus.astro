---
// 2026-10-12 (세운 승인, 1단계): 날짜 페이지마다 토론 하나. 댓글은 공개 저장소
// yuli3/oiyo-news-discussions 의 Discussions(Announcements: giscus·관리자만 새 글)에 쌓인다.
// 회원 DB 없음. 스크립트는 화면 근처에 올 때만 불러 LCP·광고 로드를 건드리지 않는다.
interface Props { term: string }
const { term } = Astro.props;
---
<section class="discussion" aria-labelledby="discussion-title">
  <h2 id="discussion-title">오늘 뉴스 이야기 나눠요</h2>
  <p class="discussion-note">GitHub 계정으로 댓글과 반응을 남길 수 있어요. 남긴 댓글은 GitHub Discussions에 공개로 저장돼요.</p>
  <div class="giscus-slot" data-giscus-term={term}><p class="discussion-loading">댓글을 불러오고 있어요…</p></div>
</section>
<script>
  const ATTRS: Record<string, string> = {
    "data-repo": "yuli3/oiyo-news-discussions",
    "data-repo-id": "R_kgDOVF_RCQ",
    "data-category": "Announcements",
    "data-category-id": "DIC_kwDOVF_RCc4DIDrM",
    "data-mapping": "specific",
    "data-strict": "1",
    "data-reactions-enabled": "1",
    "data-emit-metadata": "0",
    "data-input-position": "top",
    "data-theme": "light",
    "data-lang": "ko",
    "data-loading": "lazy",
  };
  function mount(slot: HTMLElement) {
    if (slot.dataset.mounted) return;
    slot.dataset.mounted = "1";
    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.async = true;
    s.crossOrigin = "anonymous";
    for (const [k, v] of Object.entries(ATTRS)) s.setAttribute(k, v);
    s.setAttribute("data-term", slot.dataset.giscusTerm ?? location.pathname);
    slot.replaceChildren(s);
  }
  for (const slot of document.querySelectorAll<HTMLElement>("[data-giscus-term]")) {
    if (!("IntersectionObserver" in window)) { mount(slot); continue; }
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); mount(slot); }
    }, { rootMargin: "600px 0px" });
    io.observe(slot);
  }
</script>
<style>
  .discussion { margin-top:28px; padding-top:16px; border-top:1px solid var(--border) }
  .discussion h2 { font-size:17px; margin:0 0 4px }
  .discussion-note { font-size:12.5px; color:var(--muted); margin:0 0 12px }
  .giscus-slot { min-height:320px }
  .discussion-loading { font-size:13px; color:var(--muted) }
</style>
