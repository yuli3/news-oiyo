---
// 2026-11-10 세운 결정(클리앙 실버블렛스톡 차용): 지난 방문 뒤 새 소식 배지 + 저장한 기사 강조.
// 방문 시각·저장 목록은 이 브라우저에만 둔다(서버 전송 없음).
interface Props { recent: number[] }
const { recent } = Astro.props;
---
<a class="new-badge" id="new-badge" href="/" hidden><span class="new-dot" aria-hidden="true"></span><span class="new-label">새 소식 </span><b id="new-count">0</b></a>
<script type="application/json" id="recent-stamps" set:html={JSON.stringify(recent)} />
<script>
  import { countNewer, visitBaseline } from "../lib/unread";
  import { readSaved } from "../lib/saved";

  const baseline = visitBaseline(localStorage, sessionStorage, Date.now());
  const badge = document.getElementById("new-badge");
  const count = document.getElementById("new-count");
  let recent: number[] = [];
  try { recent = JSON.parse(document.getElementById("recent-stamps")?.textContent ?? "[]"); } catch { /* 빈 목록 */ }
  const n = countNewer(recent, baseline);
  if (badge && count && n > 0) {
    count.textContent = n > 99 ? "99+" : String(n);
    badge.setAttribute("aria-label", `지난 방문 뒤 새 소식 ${n}건`);
    badge.hidden = false;
    badge.addEventListener("click", () => {
      const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
      if (g) g("event", "unread_badge_click", { value: n });
    });
  }

  // 목록 항목: 새 소식 점, 저장한 기사 강조.
  const paintItems = () => {
    const saved = new Set(readSaved().map((x) => x.url));
    for (const li of document.querySelectorAll<HTMLElement>("li.news-item[data-url]")) {
      li.classList.toggle("is-saved", saved.has(li.dataset.url!));
      const t = Date.parse(li.dataset.fetched ?? "");
      li.classList.toggle("is-new", baseline !== null && Number.isFinite(t) && t > baseline);
    }
    const savedCount = document.querySelectorAll<HTMLElement>("[data-saved-count]");
    for (const el of savedCount) el.textContent = saved.size > 0 ? ` ${saved.size}` : "";
  };
  paintItems();
  document.addEventListener("click", (e) => {
    if ((e.target as Element | null)?.closest?.("button[data-save-url]")) setTimeout(paintItems, 0);
  });
</script>
<style>
  .new-badge { display:inline-flex; align-items:center; gap:5px; min-height:32px; padding:0 10px; border-radius:999px; background:var(--accent); color:#fff; font-size:12px; font-weight:750; text-decoration:none; white-space:nowrap }
  .new-badge:hover { filter:brightness(1.08) }
  .new-badge:focus-visible { outline:2px solid var(--ink); outline-offset:2px }
  .new-badge[hidden] { display:none }
  .new-dot { width:6px; height:6px; border-radius:50%; background:#fff }
  @media (max-width:480px) { .new-label { display:none } .new-badge { padding:0 8px } }
</style>
<style is:global>
  li.news-item.is-saved { box-shadow:inset 3px 0 0 var(--accent); padding-left:12px !important }
  li.news-item.is-new [data-slot="item-title"]::before { content:"새"; display:inline-block; margin-right:6px; padding:0 6px; border-radius:999px; background:var(--accent-soft); color:var(--accent); font-size:11px; font-weight:800; vertical-align:.1em }
  li.news-item:target { background:var(--accent-soft); border-radius:8px; scroll-margin-top:80px }
</style>
