---
import { newsTranslations } from "../data/news-translations";
import { relativeKo } from "../lib/relative-time";

interface Props {
  title: string;
  href: string;
  source: string;
  sourceColor?: string;
  score?: number | null;
  domain?: string;
  comments?: number | null;
  publishedAt?: string;
  fetchedAt?: string;
  date?: string;
  discussionUrl?: string;
}

const SOURCE_LABEL: Record<string, string> = {
  "hacker-news": "Hacker News",
  HN: "Hacker News",
  lobsters: "Lobsters",
  Lobsters: "Lobsters",
  geeknews: "GeekNews",
  GeekNews: "GeekNews",
  reddit: "Reddit",
  Reddit: "Reddit",
  "openai-news": "OpenAI News",
  OpenAI: "OpenAI News",
  "deepmind-blog": "Google DeepMind",
  DeepMind: "Google DeepMind",
  "karpathy-blog": "Karpathy",
  Karpathy: "Karpathy",
  "yahoo-finance": "Yahoo Finance",
  techcrunch: "TechCrunch",
  TechCrunch: "TechCrunch",
  github: "GitHub",
  GitHub: "GitHub",
};

const {
  title,
  href,
  source,
  sourceColor = "var(--muted)",
  score,
  domain,
  comments,
  publishedAt,
  fetchedAt,
  date,
  discussionUrl,
} = Astro.props;
const translation = newsTranslations[href];
const label = SOURCE_LABEL[source] ?? source;
const when = relativeKo(publishedAt ?? fetchedAt ?? (date ? `${date}T00:00:00Z` : undefined));
---

<li data-slot="item" class="news-item">
  <div class="item-head">
    <a data-slot="item-title" href={href} target="_blank" rel="noopener noreferrer">{title}</a>
    {domain && <span class="item-domain">({domain})</span>}
  </div>
  {translation?.title && <p class="item-ko" lang="ko">{translation.title}</p>}
  <p data-slot="item-description" class="item-meta">
    <span class="item-source" style={`--source-dot:${sourceColor}`}>{label}</span>
    {when && <> · {when}</>}
    {score != null && <> · ▲{score}</>}
    {comments != null && (
      discussionUrl
        ? <> · <a class="item-comments" href={discussionUrl} target="_blank" rel="noopener noreferrer">+{comments} comments</a></>
        : <> · +{comments} comments</>
    )}
  </p>
  {translation && (
    <details class="translation">
      <summary>한국어 요약 읽기</summary>
      <div class="translation-body" lang="ko">
        <p class="translation-meta">OIYO 한국어 요약 · 원문 확인 <time datetime={translation.reviewedAt}>{translation.reviewedAt}</time></p>
        <p>{translation.intro}</p>
        {translation.sections.map((section) => (
          <section>
            <h3>{section.heading}</h3>
            <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          </section>
        ))}
        <p class="translation-meta">원제: <span lang="en">{title}</span></p>
        <ul class="translation-sources" aria-label="요약 출처">
          {translation.sources.map((entry) => (
            <li><a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.label}</a></li>
          ))}
        </ul>
      </div>
    </details>
  )}
</li>

<style>
  .news-item { margin:0; padding:10px 4px 12px; border-bottom:1px solid var(--border) }
  .news-item:last-child { border-bottom-color:transparent }
  .item-head { display:block; line-height:1.4 }
  [data-slot="item-title"] { color:var(--ink); text-decoration:none; font-weight:650; overflow-wrap:anywhere }
  [data-slot="item-title"]:visited { color:var(--muted) }  /* #82857a 는 3.27:1 로 미달이었다 */
  [data-slot="item-title"]:hover { color:var(--accent) }
  [data-slot="item-title"]:focus-visible { outline:2px solid var(--accent); outline-offset:3px; border-radius:3px }
  .item-domain { margin-left:6px; font-size:12px; color:var(--muted); font-weight:500 }
  .item-ko { margin:3px 0 0; font-size:13.5px; color:#4a4c42; line-height:1.45 }
  .item-meta { margin:4px 0 0; font-size:12px; color:var(--muted); line-height:1.45 }
  /* 출처 브랜드 색을 **글자에 쓰지 않는다.** HN #ff6600 은 이 지면에서
     2.55:1, GeekNews #0abf53 은 2.12:1 로 본문 기준(4.5)에 한참 못 미친다.
     색을 어둡게 바꾸면 통과하지만 민트→진녹처럼 브랜드 인지가 달라진다.
     WCAG 는 **글자**에만 대비를 요구하므로, 색은 점으로 옮기고 글자는
     --muted(4.74:1)로 둔다. 브랜드 색을 지키면서 통과한다. */
  .item-source { font-weight:750 }
  .item-source::before {
    content:""; display:inline-block; width:.5em; height:.5em; border-radius:50%;
    background:var(--source-dot, var(--muted)); margin-right:.4em; vertical-align:.04em;
  }
  .item-comments { color:var(--muted); text-decoration:none; font-weight:650 }
  .item-comments:hover { color:var(--accent) }
  .translation { margin-top:2px; font-size:14px }
  .translation summary { cursor:pointer; color:var(--accent); font-weight:650; padding:12px 0; min-height:44px; box-sizing:border-box }
  .translation summary:focus-visible { outline:2px solid var(--accent); outline-offset:3px; border-radius:3px }
  .translation-body { max-width:72ch; line-height:1.75; overflow-wrap:anywhere; padding:0 0 12px }
  .translation-body h3 { font-size:15px; margin:20px 0 6px }
  .translation-body ul { padding-left:20px }
  .translation-body li { margin:6px 0 }
  .translation-meta { font-size:12px; color:var(--muted) }
  .translation-sources { display:flex; flex-wrap:wrap; gap:4px 20px; list-style:none; padding:0!important; font-size:12px }
</style>
