---
import { newsTranslations } from "../data/news-translations";
import { relativeKo } from "../lib/relative-time";
import { isCuratorSource } from "../lib/feed";
import SaveButton from "./SaveButton.astro";
import Mentions from "./Mentions.astro";
import { mentionChips, mentionCount, type Mention } from "../lib/mentions";

interface Props {
  title: string;
  /** 원제에 한글이 없을 때의 한국어 제목(2026-11-28). 있으면 크게, 원제는 아래에 작게. */
  titleKo?: string;
  href: string;
  source: string;
  sourceColor?: string;
  score?: number | null;
  domain?: string;
  comments?: number | null;
  summary?: string;
  /** Stable item id (trend-<hash>) for /item/<id>/ detail page. */
  itemId?: string;
  publishedAt?: string;
  fetchedAt?: string;
  date?: string;
  discussionUrl?: string;
  /** 일일판에서 검색 결과가 가리킬 앵커(trend-<hash>). 2026-11-10 */
  anchorId?: string;
  /** 같은 원문·같은 소식을 다룬 다른 출처(2026-11-17, 언급 출처 배지). */
  mentions?: Mention[];
  sourceId?: string;
}

const SOURCE_LABEL: Record<string, string> = {
  "hacker-news": "Hacker News",
  HN: "Hacker News",
  lobsters: "Lobsters",
  Lobsters: "Lobsters",
  geeknews: "GeekNews",
  GeekNews: "GeekNews",
  reddit: "Reddit",
  Reddit: "Reddit",
  "openai-news": "OpenAI News",
  OpenAI: "OpenAI News",
  "deepmind-blog": "Google DeepMind",
  DeepMind: "Google DeepMind",
  "karpathy-blog": "Karpathy",
  Karpathy: "Karpathy",
  "google-developers": "Google Developers Blog",
  GoogleDev: "Google Developers Blog",
  "nvidia-developer": "NVIDIA Technical Blog",
  NVIDIADev: "NVIDIA Technical Blog",
  "yahoo-finance": "Yahoo Finance",
  techcrunch: "TechCrunch",
  TechCrunch: "TechCrunch",
  github: "GitHub",
  GitHub: "GitHub",
  aitimes: "AI타임스",
  "AI타임스": "AI타임스",
  "zdnet-kr": "ZDNet Korea",
  "지디넷": "ZDNet Korea",
  // 2026-11-20 UI 점검: 금융 소스가 "hankyung-finance"처럼 내부 id 그대로 보였어요.
  "hankyung-finance": "한국경제",
  hankyung: "한국경제",
  "hankyung-realestate": "한국경제 부동산",
  "mk-economy": "매일경제",
  bok: "한국은행",
  moef: "재정경제부",
  "federal-reserve": "Federal Reserve",
  sec: "SEC",
  coindesk: "CoinDesk",
  "cnbc-finance": "CNBC",
  "r-localllama": "Reddit",
  "r-machinelearning": "Reddit",
};

const {
  title,
  titleKo,
  href,
  source,
  sourceColor = "var(--muted)",
  score,
  summary,
  itemId,
  domain,
  comments,
  publishedAt,
  fetchedAt,
  date,
  discussionUrl,
  anchorId,
  mentions,
  sourceId,
} = Astro.props;
const detailHref = itemId ? `/item/${itemId}/` : undefined;
const translation = newsTranslations[href];
const label = SOURCE_LABEL[source] ?? source;
const shownTitle = titleKo?.trim() || title;
const origTitle = titleKo?.trim() ? title : undefined;
// 2026-10-07: 큐레이터(HN·GeekNews·Lobsters·Reddit)는 "어디서 화제인지"만 알려 준다.
// 제목 링크는 원문이고, 큐레이터는 토론 링크와 함께 출처 표기로만 남긴다.
const curator = isCuratorSource(source);
const chips = mentionChips({ src: source, sourceId, url: href, domain, score, comments, discussionUrl, mentions });
// 목록 페이지에는 앵커가 없을 수 있다 — 원문 URL로 겹치지 않는 id를 만든다.
const urlKey = [...href].reduce((h, ch) => (Math.imul(h, 31) + ch.charCodeAt(0)) >>> 0, 7).toString(36);
const mentionsId = chips.length ? `mentions-${anchorId ?? itemId ?? urlKey}` : undefined;
const when = relativeKo(publishedAt ?? fetchedAt ?? (date ? `${date}T00:00:00Z` : undefined));
---

<li data-slot="item" class="news-item" data-source={source} id={anchorId} data-url={href} data-fetched={fetchedAt ?? publishedAt}>
  <div class="item-head">
    <a data-slot="item-title" href={href} target="_blank" rel="noopener noreferrer">{shownTitle}</a>
    {domain && <span class="item-domain">({domain})</span>}
    {chips.length > 0 && (
      <a class="fn-mark" href={`#${mentionsId}`} aria-label={`${mentionCount(chips)}곳에서 언급 — 출처 보기`}>{mentionCount(chips)}</a>
    )}
  </div>
  {origTitle && <p class="item-orig">{origTitle}</p>}
  {!origTitle && translation?.title && <p class="item-ko" lang="ko">{translation.title}</p>}
  {summary && <p class="item-summary">{summary}</p>}
  <p data-slot="item-description" class="item-meta">
    {curator && discussionUrl ? (
      <a class="item-source item-curator" style={`--source-dot:${sourceColor}`} href={discussionUrl} target="_blank" rel="noopener noreferrer">{label}에서 화제</a>
    ) : (
      <span class="item-source" style={`--source-dot:${sourceColor}`}>{curator ? `${label}에서 화제` : label}</span>
    )}
    {when && <> · {when}</>}
    {score != null && <> · ▲{score}</>}
    {comments != null && (
      discussionUrl && !curator
        ? <> · <a class="item-comments" href={discussionUrl} target="_blank" rel="noopener noreferrer">+{comments} comments</a></>
        : <> · +{comments} comments</>
    )}
    {detailHref && (
      <> · <a class="item-detail" href={detailHref}>자세히 읽기</a></>
    )}
    <SaveButton url={href} title={titleKo?.trim() || translation?.title || title} source={label} date={date} />
  </p>
  <Mentions chips={chips} mentions={mentions} id={mentionsId} />
  {translation && (
    <details class="translation">
      <summary>한국어 요약 읽기</summary>
      <div class="translation-body" lang="ko">
        <p class="translation-meta">OIYO 한국어 요약 · 원문 확인 <time datetime={translation.reviewedAt}>{translation.reviewedAt}</time></p>
        <p>{translation.intro}</p>
        {translation.sections.map((section) => (
          <section>
            <h3>{section.heading}</h3>
            <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          </section>
        ))}
        <p class="translation-meta">원제: <span lang="en">{title}</span></p>
        <ul class="translation-sources" aria-label="요약 출처">
          {translation.sources.map((entry) => (
            <li><a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.label}</a></li>
          ))}
        </ul>
      </div>
    </details>
  )}
</li>

<style>
  .news-item { margin:0; padding:12px 4px 14px; border-bottom:1px solid var(--border) }
  .news-item:last-child { border-bottom-color:transparent }
  .item-head { display:block; line-height:1.4 }
  [data-slot="item-title"] { color:var(--ink); text-decoration:none; font-weight:650; font-size:16px; overflow-wrap:anywhere }
  [data-slot="item-title"]:visited { color:var(--muted) }  /* #82857a 는 3.27:1 로 미달이었다 */
  [data-slot="item-title"]:hover { color:var(--accent) }
  [data-slot="item-title"]:focus-visible { outline:2px solid var(--accent); outline-offset:3px; border-radius:3px }
  .item-domain { margin-left:6px; font-size:12px; color:var(--muted); font-weight:500 }
  /* 각주 표시: 제목 끝에 언급 출처 수. 아래 배지 줄로 이동한다. */
  .fn-mark {
    display:inline-flex; align-items:center; justify-content:center; min-width:1.5em; height:1.5em; padding:0 .35em;
    margin-left:6px; border-radius:999px; background:var(--accent-soft); color:var(--accent);
    font-size:11px; font-weight:800; text-decoration:none; vertical-align:.25em; line-height:1;
  }
  .fn-mark:hover { background:var(--accent); color:var(--card) }
  .fn-mark:focus-visible { outline:2px solid var(--accent); outline-offset:2px }
  .item-ko { margin:3px 0 0; font-size:13.5px; color:#4a4c42; line-height:1.45 }
  /* 한국어 제목 아래 원제. 검색·대조용이라 메타보다 살짝 크게만 둔다. */
  .item-orig { margin:2px 0 0; font-size:12.5px; color:var(--muted); line-height:1.4; overflow-wrap:anywhere }
  /* 제목 아래 한 줄. 원문 설명 그대로이므로 번역 요약(.item-ko)보다 약하게 둔다. */
  .item-summary { margin:4px 0 0; font-size:14px; color:#4a4c42; line-height:1.6; overflow-wrap:anywhere }
  .item-meta { margin:4px 0 0; font-size:12px; color:var(--muted); line-height:1.45 }
  /* 출처 브랜드 색을 **글자에 쓰지 않는다.** HN #ff6600 은 이 지면에서
     2.55:1, GeekNews #0abf53 은 2.12:1 로 본문 기준(4.5)에 한참 못 미친다.
     색을 어둡게 바꾸면 통과하지만 민트→진녹처럼 브랜드 인지가 달라진다.
     WCAG 는 **글자**에만 대비를 요구하므로, 색은 점으로 옮기고 글자는
     --muted(4.74:1)로 둔다. 브랜드 색을 지키면서 통과한다. */
  .item-source { font-weight:750 }
  .item-source::before {
    content:""; display:inline-block; width:.5em; height:.5em; border-radius:50%;
    background:var(--source-dot, var(--muted)); margin-right:.4em; vertical-align:.04em;
  }
  .item-curator { color:var(--muted); text-decoration:none }
  .item-curator:hover { color:var(--accent) }
  .item-comments, .item-detail { color:var(--muted); text-decoration:none; font-weight:650 }
  .item-comments:hover, .item-detail:hover { color:var(--accent) }
  .item-detail { text-decoration:underline; text-underline-offset:2px; white-space:nowrap }
  .item-source, .item-comments { white-space:nowrap }
  .translation { margin-top:2px; font-size:14px }
  .translation summary { cursor:pointer; color:var(--accent); font-weight:650; padding:12px 0; min-height:44px; box-sizing:border-box }
  .translation summary:focus-visible { outline:2px solid var(--accent); outline-offset:3px; border-radius:3px }
  .translation-body { max-width:72ch; line-height:1.75; overflow-wrap:anywhere; padding:0 0 12px }
  .translation-body h3 { font-size:15px; margin:20px 0 6px }
  .translation-body ul { padding-left:20px }
  .translation-body li { margin:6px 0 }
  .translation-meta { font-size:12px; color:var(--muted) }
  .translation-sources { display:flex; flex-wrap:wrap; gap:4px 20px; list-style:none; padding:0!important; font-size:12px }
</style>
