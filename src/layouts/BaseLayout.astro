---
interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: "website" | "article";
  crumbs?: Crumb[];
  publishedTime?: string;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  type = "website",
  crumbs = [],
  publishedTime,
} = Astro.props;
const fullTitle = title.includes("OIYO News") ? title : `${title} | OIYO News`;
const family = [
  ["OIYO tests", "https://oiyo.net/ko/"],
  ["OIYO blog", "https://blog.oiyo.net/ko/"],
  ["OIYO wiki", "https://wiki.oiyo.net/ko/"],
  ["OIYO game", "https://game.oiyo.net/ko/"],
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="naver-site-verification" content="a0581b46dbe24516d99443dd0e08a672ae50de8a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4d7c0f" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content="https://news.oiyo.net/og-image.png" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-915L6V38X6"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-915L6V38X6');</script>
    <title>{fullTitle}</title>
    <slot name="head" />
    <style is:global>
      :root{--bg:oklch(.988 .003 106.5);--card:oklch(.99 .005 106.5);--ink:oklch(.153 .006 107.1);--muted:oklch(.58 .031 107.3);--accent:oklch(.49 .12 128);--accent-soft:oklch(.95 .025 112);--border:oklch(.91 .012 106.5)}
      *{box-sizing:border-box}html{background:var(--bg)}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans KR",sans-serif;font-size:15px;line-height:1.6}a{color:var(--accent)}
      .site-header{border-bottom:1px solid var(--border);background:color-mix(in oklch,var(--bg) 94%,transparent);position:sticky;top:0;z-index:5}.header-inner{max-width:900px;min-height:52px;margin:auto;padding:0 16px;display:flex;align-items:center;gap:18px}.brand{color:var(--ink);text-decoration:none;font-size:18px;font-weight:850;letter-spacing:-.035em}.brand span{color:var(--accent);font-weight:720}.primary-nav{display:flex;gap:16px;margin-left:auto}.primary-nav a{color:var(--muted);text-decoration:none;font-size:13px;font-weight:700}.primary-nav a:hover,.primary-nav a[aria-current="page"]{color:var(--accent)}
      .shell{max-width:900px;margin:auto;padding:14px 16px 80px}.breadcrumb{display:flex;flex-wrap:wrap;gap:6px;align-items:center;min-height:34px;margin-bottom:12px;color:var(--muted);font-size:12px}.breadcrumb a{color:var(--muted);text-decoration:none}.breadcrumb a:hover{color:var(--accent)}.breadcrumb span+span::before,.breadcrumb a+span::before,.breadcrumb a+a::before{content:"/";margin-right:6px;color:var(--border)}
      h1{font-size:clamp(25px,5vw,34px);line-height:1.2;letter-spacing:-.035em;margin:.45em 0}.lede{max-width:680px;color:var(--muted);font-size:16px}.section-title{margin-top:36px;padding-bottom:7px;border-bottom:2px solid var(--accent);font-size:19px}.doc-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.doc-link{display:block;min-height:104px;padding:16px;border:1px solid var(--border);border-radius:12px;background:var(--card);color:var(--ink);text-decoration:none}.doc-link:hover{border-color:var(--accent)}.doc-link strong{display:block;margin-bottom:5px}.doc-link span{color:var(--muted);font-size:13px}
      h2{font-size:20px;margin-top:2em;border-bottom:2px solid var(--accent);padding-bottom:6px}.sub{color:var(--muted);font-size:15px}.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px 18px;margin:12px 0}.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}.tag{display:inline-block;background:var(--accent-soft);color:var(--accent);border-radius:999px;padding:2px 10px;font-size:11.5px;font-weight:800;margin-right:6px}.card a{text-decoration:none;font-weight:700}
      .site-footer{border-top:1px solid var(--border);background:var(--card)}.footer-inner{max-width:900px;margin:auto;padding:30px 16px 36px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.footer-group strong{display:block;margin-bottom:9px;font-size:12px;color:var(--ink)}.footer-group a,.footer-group span{display:block;width:max-content;max-width:100%;margin:6px 0;color:var(--muted);text-decoration:none;font-size:12px}.footer-group a:hover{color:var(--accent)}
      button,[role=button],a{touch-action:manipulation}@media(max-width:640px){.header-inner{min-height:50px}.primary-nav{gap:12px}.primary-nav a:first-child{display:none}.shell{padding-inline:14px}.doc-grid{grid-template-columns:1fr}.footer-inner{grid-template-columns:1fr 1fr}.footer-group:last-child{grid-column:1/-1}}
    </style>
  </head>
  <body>
    <header class="site-header"><div class="header-inner"><a class="brand" href="/">OIYO <span>news</span></a><nav class="primary-nav" aria-label="주요 탐색"><a href="/">최신 뉴스</a><a href="/ai/">AI</a><a href="/systems/">Systems</a></nav></div></header>
    <main class="shell">
      {crumbs.length > 0 && <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a>{crumbs.map((crumb) => crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>)}</nav>}
      <slot />
    </main>
    <footer class="site-footer"><div class="footer-inner"><div class="footer-group"><strong>News</strong><a href="/">최신 뉴스</a><a href="/ai/">AI 모델·도구</a><a href="/systems/">운영 시스템</a></div><div class="footer-group"><strong>안내</strong><span>출처 기반 기술·경제 큐레이션</span><span>개인화된 투자 권유가 아닙니다</span><span>© {new Date().getFullYear()} OIYO</span></div><div class="footer-group"><strong>OIYO 패밀리</strong>{family.map(([label,href]) => <a href={`${href}?utm_source=news&utm_medium=footer&utm_campaign=family_nav`}>{label}</a>)}</div></div></footer>
  </body>
</html>
