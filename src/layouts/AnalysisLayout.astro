---
import ManualAds from "../components/ManualAds.astro";
// 2026-10-15: isolate authored multilingual articles from Grok's daily-news shell.
// BaseLayout is Korean-only; changing its language would affect unrelated routes.
const locales = ["ko", "en", "ja", "zh", "fr", "es"] as const;
type Locale = typeof locales[number];
interface Props { frontmatter: { title: string; description: string; lang: Locale; date: string; slug: string; }; }
const { title, description, lang, date, slug } = Astro.props.frontmatter;
const labels = {
  ko: ["분석", "최신 뉴스", "AI", "본문 바로가기", "다른 언어", "발행·출처 확인", "OIYO 편집부", "관련 정보", "패밀리 사이트", "개인정보", "이용약관"],
  en: ["Analysis", "Latest news", "AI", "Skip to content", "Other languages", "Published · sources checked", "OIYO Editorial", "Related information", "Family sites", "Privacy", "Terms"],
  ja: ["分析", "最新ニュース", "AI", "本文へ", "他の言語", "公開・出典確認", "OIYO編集部", "関連情報", "ファミリーサイト", "プライバシー", "利用規約"],
  zh: ["分析", "最新资讯", "AI", "跳至正文", "其他语言", "发布与来源核对", "OIYO编辑部", "相关信息", "网站家族", "隐私", "使用条款"],
  fr: ["Analyses", "Actualités", "IA", "Aller au contenu", "Autres langues", "Publication · sources vérifiées", "Rédaction OIYO", "Pour aller plus loin", "Sites du groupe", "Confidentialité", "Conditions"],
  es: ["Análisis", "Noticias", "IA", "Ir al contenido", "Otros idiomas", "Publicación · fuentes comprobadas", "Redacción OIYO", "Información relacionada", "Sitios del grupo", "Privacidad", "Condiciones"],
}[lang];
const names = { ko: "한국어", en: "English", ja: "日本語", zh: "简体中文", fr: "Français", es: "Español" };
const href = (locale: Locale) => `https://news.oiyo.net/analysis/${locale}/${slug}/`;
const canonical = href(lang);
// The editorial date is known, but an exact publication time is not; do not invent one.
const article = { "@context": "https://schema.org", "@type": "Article", headline: title, description, inLanguage: lang, datePublished: date, dateModified: date, author: { "@type": "Organization", name: labels[6], url: "https://news.oiyo.net/" }, publisher: { "@type": "Organization", name: "OIYO News", url: "https://news.oiyo.net/" }, mainEntityOfPage: canonical, image: "https://news.oiyo.net/og-image.png" };
const crumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "OIYO News", item: "https://news.oiyo.net/" }, { "@type": "ListItem", position: 2, name: labels[0], item: "https://news.oiyo.net/analysis/" }, { "@type": "ListItem", position: 3, name: title, item: canonical }] };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | OIYO News</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map(locale => <link rel="alternate" hreflang={locale} href={href(locale)} />)}
    <link rel="alternate" hreflang="x-default" href={href("ko")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="naver-site-verification" content="a0581b46dbe24516d99443dd0e08a672ae50de8a" />
    <meta property="og:type" content="article" /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://news.oiyo.net/og-image.png" /><meta name="twitter:card" content="summary_large_image" />
    <meta property="article:published_time" content={date} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(article)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script is:inline>
      // Same production property and localhost exclusion as BaseLayout; no new tracking events.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      if (!/^(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\])$/.test(location.hostname)) {
        gtag('js', new Date()); gtag('config', 'G-915L6V38X6');
        var analytics = document.createElement('script'); analytics.async = true;
        analytics.src = 'https://www.googletagmanager.com/gtag/js?id=G-915L6V38X6'; document.head.appendChild(analytics);
      }
    </script>
    {/* Preserve the site's existing ad setup; this article does not change account policy or placements. */}
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9541920090543312" crossorigin="anonymous"></script>
  </head>
  <body>
    <a class="skip" href="#content">{labels[3]}</a>
    <header><a class="brand" href="/">OIYO news</a><nav aria-label={labels[7]}><a href="/ai/">{labels[2]}</a><a href="/analysis/">{labels[0]}</a></nav></header>
    <main id="content">
      <nav class="languages" aria-label={labels[4]}>{locales.map(locale => <a href={`/analysis/${locale}/${slug}/`} lang={locale} hreflang={locale} aria-current={locale === lang ? "page" : undefined}>{names[locale]}</a>)}</nav>
      <article><p class="eyebrow">{labels[0]} · {labels[6]}</p><h1>{title}</h1><p class="lede">{description}</p><p class="meta">{labels[5]}: <time datetime={date}>{date}</time></p><slot /><ManualAds /></article>
      <aside aria-label={labels[7]}><h2>{labels[7]}</h2><a href="/ai/">{labels[2]} · OIYO News</a> · <a href="/">{labels[1]} <span lang="ko">(한국어)</span></a></aside>
    </main>
    <footer><p>{labels[8]}: <a href={`https://oiyo.net/${lang}/`}>OIYO</a> · <a href={`https://blog.oiyo.net/${lang}/`}>Blog</a> · <a href={`https://wiki.oiyo.net/${lang}/`}>Wiki</a> · <a href={`https://game.oiyo.net/${lang}/`}>Game</a></p><p><a href={`https://blog.oiyo.net/${lang}/privacy/`}>{labels[9]}</a> · <a href={`https://blog.oiyo.net/${lang}/terms/`}>{labels[10]}</a></p><p><a href="https://ko-fi.com/tqqq3">Ko-fi</a> · <a href="https://paypal.me/chosean">PayPal</a></p><p>© {new Date().getFullYear()} Oiyo Tech</p></footer>
  </body>
</html>
<style is:global>
  /* Reuse News' olive tokens without editing its concurrently owned global shell. */
  :root{--bg:oklch(.951 .011 123.5);--card:oklch(.985 .007 124.4);--ink:oklch(.207 .020 138.8);--muted:oklch(.52 .028 132.3);--accent:oklch(.47 .095 133.2);--accent-soft:oklch(.915 .038 125.2);--border:oklch(.857 .030 126)}
  *{box-sizing:border-box}html{background:var(--bg);color:var(--ink);font-family:system-ui,sans-serif;line-height:1.8}body{margin:0}a{color:var(--accent);text-underline-offset:.2em;overflow-wrap:anywhere}a:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}header,main,footer{max-width:800px;margin:auto;padding:18px}header{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--border)}header nav{display:flex;gap:18px}.brand{font-weight:800;text-decoration:none}.skip{position:absolute;left:16px;top:-100px;background:var(--card);padding:12px}.skip:focus{top:8px}main{padding-bottom:48px}.languages{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 28px}.languages a{padding:6px 9px;min-height:44px;border:1px solid var(--border);border-radius:8px;text-decoration:none}.languages [aria-current]{background:var(--accent-soft);font-weight:700}.eyebrow,.meta{font-size:.85rem;color:var(--muted)}h1{font-size:clamp(1.7rem,5vw,2.35rem);line-height:1.35;overflow-wrap:anywhere}h2{font-size:1.3rem;line-height:1.5;margin-top:2.4em;border-bottom:1px solid var(--border);padding-bottom:8px}h3{font-size:1.1rem;margin-top:1.8em}.lede{font-size:1.08rem;color:var(--muted)}article p,article li{overflow-wrap:anywhere}article li{margin-block:.5em}blockquote{margin:24px 0;padding:16px;border-inline-start:4px solid var(--accent);background:var(--card)}blockquote p{margin:0}.table-scroll{overflow-x:auto;border:1px solid var(--border);border-radius:8px;margin:20px 0}.table-scroll:focus-visible{outline:3px solid var(--accent)}table{border-collapse:collapse;width:100%;font-size:.92rem}th,td{text-align:start;padding:12px;vertical-align:top;border-bottom:1px solid var(--border);min-width:120px}th{background:var(--accent-soft)}caption{text-align:start;padding:12px;font-weight:700;color:var(--muted)}.cost-chart{margin:24px 0;padding:18px;background:var(--card);border:1px solid var(--border);border-radius:8px}.cost-chart p{display:grid;gap:6px}meter{width:100%;height:24px;accent-color:var(--accent)}figcaption{font-size:.9rem;color:var(--muted)}aside,footer{border-top:1px solid var(--border)}footer{font-size:.9rem;color:var(--muted)}footer p{margin-block:8px}code{overflow-wrap:anywhere}ol,ul{padding-inline-start:24px}@media(min-width:700px){main{padding-inline:28px}}
</style>
