---
import ManualAds from "../components/ManualAds.astro";
import { LOCALES, LOCALE_NAMES, UI, type Locale } from "../data/ai-i18n";
// 2026-10-20: /ai/{lang}/… pages (pricing, use-case guides). Same shell as AnalysisLayout:
// BaseLayout is Korean-only and shared with Grok's daily pages, so other languages get their own frame.
interface Props {
  lang: Exclude<Locale, "ko">;
  title: string;
  description: string;
  /** Path of this page in each locale, e.g. { ko: "/ai/pricing/", en: "/ai/en/pricing/" }. */
  paths: Record<Locale, string>;
  crumbs: { label: string; href?: string }[];
  jsonLd?: object[];
  published?: string;
}
const { lang, title, description, paths, crumbs, jsonLd = [], published } = Astro.props;
const t = UI[lang];
const abs = (p: string) => `https://news.oiyo.net${p}`;
const canonical = abs(paths[lang]);
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "OIYO News", item: "https://news.oiyo.net/" }, ...crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 2, name: c.label, ...(c.href ? { item: abs(c.href) } : { item: canonical }) }))] };
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : lang}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | OIYO News</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l === "zh" ? "zh-CN" : l} href={abs(paths[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(paths.ko)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://news.oiyo.net/og-image.png" /><meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
    {jsonLd.map((d) => <script type="application/ld+json" is:inline set:html={JSON.stringify(d)} />)}
    <script is:inline>
      // Same production property and localhost exclusion as BaseLayout; no new tracking events.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      if (!/^(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\])$/.test(location.hostname)) {
        gtag('js', new Date()); gtag('config', 'G-915L6V38X6');
        var analytics = document.createElement('script'); analytics.async = true;
        analytics.src = 'https://www.googletagmanager.com/gtag/js?id=G-915L6V38X6'; document.head.appendChild(analytics);
      }
    </script>
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9541920090543312" crossorigin="anonymous"></script>
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <header><a class="brand" href={`/ai/${lang}/use-cases/`}>OIYO news</a><nav aria-label={t.related}><a href={paths[lang].includes("pricing") ? paths[lang] : `/ai/${lang}/pricing/`}>{t.pricingShort}</a><a href={`/ai/${lang}/use-cases/`}>{t.useCasesShort}</a></nav></header>
    <main id="content">
      <nav class="crumbs" aria-label="breadcrumb"><a href={`/ai/${lang}/use-cases/`}>OIYO News</a>{crumbs.map((c) => c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>)}</nav>
      <nav class="languages" aria-label={t.otherLanguages}>{LOCALES.map((l) => <a href={paths[l]} lang={l} hreflang={l} aria-current={l === lang ? "page" : undefined}>{LOCALE_NAMES[l]}</a>)}</nav>
      <slot />
      <ManualAds />
    </main>
    <footer><p>{t.family}: <a href={`https://oiyo.net/${lang}/`}>OIYO</a> · <a href={`https://blog.oiyo.net/${lang}/`}>Blog</a> · <a href={`https://wiki.oiyo.net/${lang}/`}>Wiki</a> · <a href={`https://game.oiyo.net/${lang}/`}>Game</a></p><p><a href={`https://blog.oiyo.net/${lang}/privacy/`}>{t.privacy}</a> · <a href={`https://blog.oiyo.net/${lang}/terms/`}>{t.terms}</a></p><p>© {new Date().getFullYear()} Oiyo Tech · <a href={`https://blog.oiyo.net/${lang}/license/`}>{t.license}</a></p></footer>
  </body>
</html>
<style is:global>
  /* Same olive tokens as BaseLayout/AnalysisLayout. */
  :root{--bg:oklch(.951 .011 123.5);--card:oklch(.985 .007 124.4);--ink:oklch(.207 .020 138.8);--muted:oklch(.52 .028 132.3);--accent:oklch(.47 .095 133.2);--accent-soft:oklch(.915 .038 125.2);--border:oklch(.857 .030 126)}
  *{box-sizing:border-box}html{background:var(--bg);color:var(--ink);font-family:system-ui,sans-serif;line-height:1.7}body{margin:0;background:var(--bg)}a{color:var(--accent);text-underline-offset:.2em;overflow-wrap:anywhere}a:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}
  header,main,footer{max-width:900px;margin:auto;padding:16px}header{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--border);min-height:64px}header nav{display:flex;gap:16px;flex-wrap:wrap}header nav a{font-size:14px;font-weight:700;text-decoration:none}.brand{font-weight:800;text-decoration:none;color:var(--ink)}
  .skip{position:absolute;left:16px;top:-100px;background:var(--card);padding:12px}.skip:focus{top:8px}main{padding-bottom:48px}
  .crumbs{display:flex;flex-wrap:wrap;gap:6px;font-size:12px;color:var(--muted)}.crumbs a{color:var(--muted);text-decoration:none}.crumbs>*+*::before{content:"/";margin-right:6px;color:var(--border)}
  .languages{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 18px}.languages a{display:inline-flex;align-items:center;padding:6px 10px;min-height:44px;border:1px solid var(--border);border-radius:8px;text-decoration:none;font-size:14px}.languages [aria-current]{background:var(--accent-soft);font-weight:700}
  h1{font-size:clamp(1.6rem,5vw,2.2rem);line-height:1.3;overflow-wrap:anywhere;margin:.4em 0}h2{font-size:1.25rem;line-height:1.5;margin-top:2em;border-bottom:2px solid var(--accent);padding-bottom:6px}
  .lede{font-size:1.05rem;color:var(--muted)}.sub{color:var(--muted);font-size:14px}.tag{display:inline-block;background:var(--accent-soft);color:var(--accent);border-radius:999px;padding:2px 10px;font-size:12px;font-weight:800}
  footer{border-top:1px solid var(--border);font-size:.9rem;color:var(--muted)}footer p{margin-block:8px}ol,ul{padding-inline-start:22px}
</style>
