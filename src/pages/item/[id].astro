---
// Per-item detail reading page. Built only for items whose Korean detailSummary the
// agent-batch has filled (hasDetailPage); items without one get no page and no link.
import data from "../../data/news.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SOURCE_COLOR, flattenFeed, hasDetailPage, isCuratorSource, isRepoItem, type Day, type FeedItem } from "../../lib/feed";
import { relativeKo } from "../../lib/relative-time";

const SOURCE_LABEL: Record<string, string> = {
  "hacker-news": "Hacker News",
  HN: "Hacker News",
  lobsters: "Lobsters",
  Lobsters: "Lobsters",
  geeknews: "GeekNews",
  GeekNews: "GeekNews",
  reddit: "Reddit",
  Reddit: "Reddit",
  "openai-news": "OpenAI News",
  OpenAI: "OpenAI News",
  "deepmind-blog": "Google DeepMind",
  DeepMind: "Google DeepMind",
  "karpathy-blog": "Karpathy",
  Karpathy: "Karpathy",
  github: "GitHub",
  GitHub: "GitHub",
  aitimes: "AI타임스",
  "AI타임스": "AI타임스",
  "zdnet-kr": "ZDNet Korea",
  "지디넷": "ZDNet Korea",
};

export async function getStaticPaths() {
  const feed = flattenFeed(data.days as Day[], { includeRepos: true });
  return feed
    .filter(hasDetailPage)
    .map((it) => ({
      params: { id: it.id as string },
      props: { item: it },
    }));
}

const { item } = Astro.props as { item: FeedItem };
const id = item.id as string;
const pageUrl = `https://news.oiyo.net/item/${id}/`;
const label = SOURCE_LABEL[item.src] ?? item.src;
const when = relativeKo(item.publishedAt ?? item.fetchedAt ?? (item.date ? `${item.date}T00:00:00Z` : undefined));
const summary = item.detailSummary!.trim();
const description = summary.slice(0, 140);
const published = item.publishedAt ?? (item.date ? `${item.date}T00:00:00+09:00` : undefined);
// 2026-10-07: 요약의 근거가 무엇인지 밝힌다. 큐레이터 글만 읽고 쓴 요약은 따로 표시해요.
const curator = isCuratorSource(item.src);
const repo = isRepoItem(item);
const basisNote =
  item.detailOrigin === "curator"
    ? `원문을 읽지 못해 ${label} 소개글을 바탕으로 요약했어요.`
    : item.detailOrigin === "readme" || repo
      ? "저장소 README를 바탕으로 요약했어요."
      : item.detailOrigin === "primary"
        ? "원문을 바탕으로 요약했어요."
        : "";
const sourceDot = SOURCE_COLOR[item.src] ?? "var(--muted)";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: item.title,
  description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  datePublished: published,
  isBasedOn: item.url,
  isPartOf: { "@id": "https://news.oiyo.net/#website" },
  publisher: { "@id": "https://oiyo.net/#organization" },
  author: { "@type": "Organization", name: label },
};
---
<BaseLayout
  title={`${item.title} — OIYO News`}
  description={description}
  canonical={pageUrl}
  type="article"
  publishedTime={published}
  crumbs={[{ label: "자세히", href: `/item/${id}/` }, { label: item.title.slice(0, 48) }]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="detail" data-item-id={id} data-detail-status={item.detailStatus ?? "unknown"}>
    <p class="eyebrow">
      <span class="item-source" style={`--source-dot:${sourceDot}`}>{curator ? `${label}에서 화제` : repo ? "오늘의 저장소 · GitHub" : label}</span>
      {item.domain && <> · {item.domain}</>}
      {when && <> · {when}</>}
      {item.score != null && <> · ▲{item.score}</>}
    </p>
    <h1>{item.title}</h1>

    <div class="detail-summary" lang="ko">
      <p class="detail-label">OIYO 한국어 요약</p>
      <div class="detail-body">{summary}</div>
      {basisNote && <p class="detail-basis" data-detail-origin={item.detailOrigin ?? (repo ? "readme" : "unknown")}>{basisNote}</p>}
    </div>

    <p class="detail-actions">
      <a class="btn-primary" href={item.url} target="_blank" rel="noopener noreferrer">{repo ? "저장소 보기" : "원문 읽기"}</a>
      {item.discussionUrl && (
        <a class="btn-secondary" href={item.discussionUrl} target="_blank" rel="noopener noreferrer">
          {curator ? `${label} 토론` : "토론"}{item.comments != null ? ` (+${item.comments})` : ""}
        </a>
      )}
      {item.date && <a class="btn-secondary" href={`/${item.date}/`}>같은 날 모아보기</a>}
    </p>

    <p class="detail-attrib" lang="ko">
      OIYO는 원문을 그대로 옮기지 않습니다. 요약은 큐레이션 목적이며, 사실·인용은 원문 출처를 따릅니다.
    </p>
  </article>

  <style>
    .detail { padding: 16px 0 32px; max-width: 72ch; }
    .eyebrow { margin: 0 0 8px; font-size: 12px; color: var(--muted); line-height: 1.45; }
    .item-source { font-weight: 750; color: var(--muted); }
    .item-source::before {
      content: ""; display: inline-block; width: 0.5em; height: 0.5em; border-radius: 50%;
      background: var(--source-dot, var(--muted)); margin-right: 0.4em; vertical-align: 0.04em;
    }
    .detail h1 {
      margin: 0 0 18px; font-size: clamp(1.25rem, 2.5vw, 1.65rem); line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .detail-label {
      margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: 0.04em;
      text-transform: uppercase; color: var(--accent);
    }
    .detail-summary {
      background: var(--card, #f3f2ec); border: 1px solid var(--border); border-left: 3px solid var(--accent);
      border-radius: 10px; padding: 14px 16px; margin-bottom: 18px;
    }
    .detail-body {
      margin: 0; font-size: 15.5px; line-height: 1.75; color: var(--ink); white-space: pre-wrap; overflow-wrap: anywhere;
    }
    .detail-basis { margin: 10px 0 0; font-size: 12px; color: var(--muted); }
    .detail-actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 20px; }
    .btn-primary, .btn-secondary {
      display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border-radius: 999px;
      font-size: 14px; font-weight: 700; text-decoration: none; box-sizing: border-box;
    }
    .btn-primary { background: var(--ink); color: var(--bg, #fafaf7); }
    .btn-primary:hover { background: var(--accent); }
    .btn-secondary { border: 1.5px solid var(--border); color: var(--ink); }
    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
    .btn-primary:focus-visible, .btn-secondary:focus-visible {
      outline: 2px solid var(--accent); outline-offset: 3px;
    }
    .detail-attrib { margin: 0; font-size: 12px; color: var(--muted); line-height: 1.5; max-width: 60ch; }
  </style>
</BaseLayout>
