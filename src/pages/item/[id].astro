---
// Per-item detail reading page. Built only for items whose Korean detailSummary the
// agent-batch has filled (hasDetailPage); items without one get no page and no link.
import data from "../../data/news.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import Mentions from "../../components/Mentions.astro";
import { mentionChips } from "../../lib/mentions";
import { SOURCE_COLOR, flattenFeed, hasDetailPage, isCuratorSource, isFoldedStory, isRepoItem, displayTitle, originalTitle, type Day, type FeedItem } from "../../lib/feed";
import { relativeKo } from "../../lib/relative-time";
import { renderMarkdown } from "../../lib/markdown";
import { topicFor, topicImage } from "../../lib/topic-art";
import { storySections } from "../../../scripts/lib/story-scope.mjs";

const SOURCE_LABEL: Record<string, string> = {
  "hacker-news": "Hacker News",
  HN: "Hacker News",
  lobsters: "Lobsters",
  Lobsters: "Lobsters",
  geeknews: "GeekNews",
  GeekNews: "GeekNews",
  reddit: "Reddit",
  Reddit: "Reddit",
  "openai-news": "OpenAI News",
  OpenAI: "OpenAI News",
  "deepmind-blog": "Google DeepMind",
  DeepMind: "Google DeepMind",
  "karpathy-blog": "Karpathy",
  Karpathy: "Karpathy",
  "google-developers": "Google Developers Blog",
  GoogleDev: "Google Developers Blog",
  "nvidia-developer": "NVIDIA Technical Blog",
  NVIDIADev: "NVIDIA Technical Blog",
  github: "GitHub",
  GitHub: "GitHub",
  aitimes: "AI타임스",
  "AI타임스": "AI타임스",
  "zdnet-kr": "ZDNet Korea",
  "지디넷": "ZDNet Korea",
};

export async function getStaticPaths() {
  // 2026-11-24: 같은 소식으로 묶인 기사(storyOf)도 옛 링크가 깨지지 않게 페이지는 남기고, 대표 기사로 안내한다.
  const feed = flattenFeed(data.days as Day[], { includeRepos: true, includeFolded: true });
  const byId = new Map(feed.map((it) => [it.id, it]));
  // 2026-11-22: 상세 페이지가 막다른 길이었다. 같은 날·같은 분야의 다른 상세 기사 4개를 잇는다.
  const withPage = feed.filter(hasDetailPage);
  const byDate = new Map<string, FeedItem[]>();
  for (const it of withPage) byDate.set(it.date, [...(byDate.get(it.date) ?? []), it]);
  return withPage.map((it) => {
    const mine = new Set(storySections(it));
    const sameDay = (byDate.get(it.date) ?? []).filter((o) => o.id !== it.id && !isRepoItem(o) && !isFoldedStory(o) && o.id !== it.storyOf);
    const related = [
      ...sameDay.filter((o) => storySections(o).some((x: string) => mine.has(x))),
      ...sameDay.filter((o) => !storySections(o).some((x: string) => mine.has(x))),
    ].slice(0, 4).map((o) => ({ id: o.id as string, title: o.title, src: o.src }));
    const lead = it.storyOf ? byId.get(it.storyOf) : undefined;
    const primary = lead ? { id: lead.id as string, title: lead.title, url: lead.url, hasPage: hasDetailPage(lead) } : undefined;
    return { params: { id: it.id as string }, props: { item: it, related, primary } };
  });
}

type Primary = { id: string; title: string; url: string; hasPage: boolean };
const { item, related = [], primary } = Astro.props as { item: FeedItem; related?: { id: string; title: string; src: string }[]; primary?: Primary };
const id = item.id as string;
const pageUrl = `https://news.oiyo.net/item/${id}/`;
// 묶인 기사는 대표 기사 상세 페이지를 canonical로 둔다(대표에 상세가 없으면 자기 자신).
const canonicalUrl = primary?.hasPage ? `https://news.oiyo.net/item/${primary.id}/` : pageUrl;
const label = SOURCE_LABEL[item.src] ?? item.src;
const when = relativeKo(item.publishedAt ?? item.fetchedAt ?? (item.date ? `${item.date}T00:00:00Z` : undefined));
const summary = item.detailSummary!.trim();
const description = summary.slice(0, 140);
const published = item.publishedAt ?? (item.date ? `${item.date}T00:00:00+09:00` : undefined);
// 2026-10-07: 요약의 근거가 무엇인지 밝힌다. 큐레이터 글만 읽고 쓴 요약은 따로 표시해요.
const curator = isCuratorSource(item.src);
const repo = isRepoItem(item);
const basisNote =
  item.detailOrigin === "curator"
    ? `원문을 읽지 못해 ${label} 소개글을 바탕으로 요약했어요.`
    : item.detailOrigin === "readme" || repo
      ? "저장소 README를 바탕으로 요약했어요."
      : item.detailOrigin === "primary"
        ? "원문을 바탕으로 요약했어요."
        : "";
// 2026-11-11: 제목으로 주제 그림을 고른다(글자·로고 없는 은유 그림).
const topicArt = topicImage(topicFor(item.title, item.domain));
const sourceDot = SOURCE_COLOR[item.src] ?? "var(--muted)";
// 2026-10-13: GeekNews식 본문 번역. 에이전트가 원문을 직접 읽고 쓴 한국어 번역·해설이에요.
const translation = item.translationKo?.trim() ?? "";
const translationHtml = translation ? renderMarkdown(translation) : "";
const translationNote =
  item.translationStatus === "blocked"
    ? "원문을 읽지 못해 접근 가능한 소개글만 옮겼어요."
    : item.translationStatus === "partial"
      ? "원문 일부를 옮겼어요. 전체 내용은 원문에서 확인해 주세요."
      : "원문을 읽고 핵심 내용을 옮겼어요.";

const shownTitle = displayTitle(item);
const origTitle = originalTitle(item);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: shownTitle,
  description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  datePublished: published,
  isBasedOn: item.url,
  isPartOf: { "@id": "https://news.oiyo.net/#website" },
  publisher: { "@id": "https://oiyo.net/#organization" },
  author: { "@type": "Organization", name: label },
};
---
<BaseLayout
  title={`${shownTitle} — OIYO News`}
  description={description}
  canonical={canonicalUrl}
  noindex
  ogImage={topicArt ? new URL(topicArt, "https://news.oiyo.net").href : undefined}
  type="article"
  publishedTime={published}
  crumbs={[{ label: "자세히", href: `/item/${id}/` }, { label: shownTitle.slice(0, 48) }]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="detail" data-item-id={id} data-detail-status={item.detailStatus ?? "unknown"}>
    <p class="eyebrow">
      <span class="item-source" style={`--source-dot:${sourceDot}`}>{curator ? `${label}에서 화제` : repo ? "오늘의 저장소 · GitHub" : label}</span>
      {item.domain && <> · {item.domain}</>}
      {when && <> · {when}</>}
      {item.score != null && <> · ▲{item.score}</>}
    </p>
    <h1>{shownTitle}</h1>
    {origTitle && <p class="orig-title">원제: {origTitle}</p>}
    {primary && (
      <p class="folded-note" lang="ko">
        같은 소식을 다룬 기사가 여럿이라 한 건으로 묶었어요. 대표 기사:
        {primary.hasPage
          ? <a href={`/item/${primary.id}/`}>{primary.title}</a>
          : <a href={primary.url} target="_blank" rel="noopener noreferrer">{primary.title}</a>}
      </p>
    )}
    {topicArt && <img class="detail-art" src={topicArt} alt="" width="1280" height="853" loading="eager" decoding="async" />}

    <div class="detail-summary" lang="ko">
      <p class="detail-label">OIYO 한국어 요약</p>
      <div class="detail-body">{summary}</div>
      {basisNote && <p class="detail-basis" data-detail-origin={item.detailOrigin ?? (repo ? "readme" : "unknown")}>{basisNote}</p>}
    </div>

    {translationHtml && (
      <section class="detail-translation" lang="ko" aria-labelledby="translation-heading" data-translation-status={item.translationStatus ?? "unknown"}>
        <h2 id="translation-heading" class="detail-label">본문 번역</h2>
        <p class="detail-basis">
          {translationNote}
          {item.translatedBy && <> · {item.translatedBy}</>}
          {item.translatedAt && <> · {item.translatedAt}</>}
        </p>
        <div class="translation-body" set:html={translationHtml} />
        <p class="detail-basis">출처: <a href={item.url} target="_blank" rel="noopener noreferrer">{item.domain || item.url}</a></p>
      </section>
    )}

    <Mentions chips={mentionChips(item)} mentions={item.mentions} id="mentions" open />

    <p class="detail-actions">
      <a class="btn-primary" href={item.url} target="_blank" rel="noopener noreferrer">{repo ? "저장소 보기" : "원문 읽기"}</a>
      {item.discussionUrl && (
        <a class="btn-secondary" href={item.discussionUrl} target="_blank" rel="noopener noreferrer">
          {curator ? `${label} 토론` : "토론"}{item.comments != null ? ` (+${item.comments})` : ""}
        </a>
      )}
      {item.date && <a class="btn-secondary" href={`/${item.date}/`}>같은 날 모아보기</a>}
    </p>

    <ShareButtons url={pageUrl} title={shownTitle} submitUrl={item.url} />

    <p class="detail-attrib" lang="ko">
      OIYO는 원문을 그대로 옮기지 않아요. 요약과 본문 번역은 큐레이션 목적이며, 사실·인용은 원문 출처를 따라요.
    </p>
  </article>

  {related.length > 0 && (
    <nav class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">같은 날 함께 읽을 소식</h2>
      <ul>{related.map((r) => <li><a href={`/item/${r.id}/`}><span class="related-src">{SOURCE_LABEL[r.src] ?? r.src}</span>{r.title}</a></li>)}</ul>
      {item.date && <a class="related-more" href={`/${item.date}/`}>이 날 소식 전체 보기 →</a>}
    </nav>
  )}

  {/* 상세 페이지는 giscus 토론이 없었다. 자체 댓글이 켜졌을 때만 보인다. */}
  <Comments thread={`item:${id}`} />

  <style>
    /* 한국어 제목 아래 원제(2026-11-28). 원문과 대조할 수 있게 남긴다. */
    .orig-title { margin:-4px 0 12px; font-size:13px; line-height:1.45; color:var(--muted); overflow-wrap:anywhere }
    .folded-note { margin:8px 0 12px; padding:10px 12px; border:1px dashed var(--border); border-radius:10px; font-size:14px; line-height:1.5; color:var(--muted) }
    .folded-note a { color:var(--accent); font-weight:700; margin-left:4px }
    .detail-art { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 12px; margin: 4px 0 20px; background: var(--accent-soft); }
    .detail { padding: 16px 0 32px; max-width: 72ch; }
    .eyebrow { margin: 0 0 8px; font-size: 12px; color: var(--muted); line-height: 1.45; }
    .item-source { font-weight: 750; color: var(--muted); }
    .item-source::before {
      content: ""; display: inline-block; width: 0.5em; height: 0.5em; border-radius: 50%;
      background: var(--source-dot, var(--muted)); margin-right: 0.4em; vertical-align: 0.04em;
    }
    .detail h1 {
      margin: 0 0 18px; font-size: clamp(1.25rem, 2.5vw, 1.65rem); line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .detail-label {
      margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: 0.04em;
      text-transform: uppercase; color: var(--accent);
    }
    .detail-summary {
      background: var(--card, #f3f2ec); border: 1px solid var(--border); border-left: 3px solid var(--accent);
      border-radius: 10px; padding: 14px 16px; margin-bottom: 18px;
    }
    .detail-body {
      margin: 0; font-size: 15.5px; line-height: 1.75; color: var(--ink); white-space: pre-wrap; overflow-wrap: anywhere;
    }
    .detail-basis { margin: 10px 0 0; font-size: 12px; color: var(--muted); }
    .detail-translation { margin: 0 0 22px; }
    .detail-translation .detail-label { margin-bottom: 4px; }
    .translation-body { font-size: 15.5px; line-height: 1.8; color: var(--ink); overflow-wrap: anywhere; }
    .translation-body :global(h3) { margin: 22px 0 8px; font-size: 1.05rem; line-height: 1.4; }
    .translation-body :global(p) { margin: 0 0 12px; }
    .translation-body :global(ul), .translation-body :global(ol) { margin: 0 0 12px; padding-left: 1.3em; }
    .translation-body :global(li) { margin: 0 0 6px; }
    .translation-body :global(blockquote) {
      margin: 0 0 12px; padding: 8px 12px; border-left: 3px solid var(--border); color: var(--muted);
    }
    .translation-body :global(blockquote p) { margin: 0; }
    .translation-body :global(code) { font-size: 0.9em; background: var(--card, transparent); padding: 0 0.25em; border-radius: 4px; }
    .translation-body :global(pre) {
      margin: 0 0 12px; padding: 10px 12px; overflow-x: auto; border: 1px solid var(--border); border-radius: 8px;
      background: var(--card, transparent);
    }
    .translation-body :global(pre code) { background: none; padding: 0; }
    .detail-translation .detail-basis a { color: var(--accent); }
    .detail-actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 20px; }
    .btn-primary, .btn-secondary {
      display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border-radius: 999px;
      font-size: 14px; font-weight: 700; text-decoration: none; box-sizing: border-box;
    }
    .btn-primary { background: var(--ink); color: var(--bg, #fafaf7); }
    .btn-primary:hover { background: var(--accent); }
    .btn-secondary { border: 1.5px solid var(--border); color: var(--ink); }
    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
    .btn-primary:focus-visible, .btn-secondary:focus-visible {
      outline: 2px solid var(--accent); outline-offset: 3px;
    }
    .related { max-width: 72ch; margin: 0 0 24px; }
    .related h2 { font-size: 17px; margin: 8px 0 8px; }
    .related ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
    .related li a { display: block; padding: 12px 2px; border-bottom: 1px solid var(--border); color: var(--ink); text-decoration: none; line-height: 1.5; overflow-wrap: anywhere; }
    .related li a:hover { color: var(--accent); }
    .related-src { display: block; font-size: 12px; color: var(--muted); font-weight: 700; }
    .related-more { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }
    .detail-attrib { margin: 0; font-size: 12px; color: var(--muted); line-height: 1.5; max-width: 60ch; }
  </style>
</BaseLayout>
