---
// 일자별 영구 URL. 홈은 최근 21일을 롤링으로만 보여주고 이전 글은 사라졌었다 —
// 이 페이지가 매일 생성한 요약·아이디어(원본 합성 콘텐츠, 단순 링크 목록이 아님)를
// 각각 고정 주소로 남겨 색인·인용 가능하게 만든다.
import data from "../data/news.json";
import Empty from "../components/Empty.astro";
import NewsItem from "../components/NewsItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOURCE_COLOR, type Day } from "../lib/feed";

export async function getStaticPaths() {
  const days = data.days as Day[];
  return days.map((d) => ({ params: { date: d.date }, props: { day: d } }));
}

const { day } = Astro.props as { day: Day };
const url = `https://news.oiyo.net/${day.date}/`;

const title = `${day.date} 기술·경제 트렌드 요약 — OIYO News`;
const description = day.summary || `${day.date} HN·Lobsters·GeekNews 큐레이션 ${day.items.length}건.`;
---
<BaseLayout title={title} description={description} canonical={url} type="article" publishedTime={`${day.date}T00:00:00+09:00`} crumbs={[{ label: day.date }]}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      headline: title,
      datePublished: `${day.date}T00:00:00+09:00`,
      description,
      url,
      isPartOf: { "@id": "https://news.oiyo.net/#website" },
      publisher: { "@id": "https://oiyo.net/#organization" },
    })} /></Fragment>
    <style>
      .day-head {
        display: flex; align-items: baseline; gap: 10px;
        border-bottom: 2px solid var(--accent); padding-bottom: 6px; margin-bottom: 10px;
      }
      .day-head h1 { font-size: 20px; margin: 0; }
      .summary {
        background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--accent);
        border-radius: 10px; padding: 10px 14px; font-size: 13.5px; color: #4a4c42; margin-bottom: 12px;
      }
      .news-list { list-style:none; margin: 0; padding: 0; border-top:1px solid var(--border); }
      .meta { font-size: 12px; color: var(--muted); margin-left: 6px; white-space: nowrap; }
      .src { font-weight: 700; }
      details.ideas { margin-top: 10px; font-size: 13px; }
      details.ideas summary { cursor: pointer; color: var(--accent); font-weight: 700; }
      details.ideas li { color: #4a4c42; }
    </style>
      <section class="day">
        <div class="day-head">
          <h1>{day.date}</h1>
          <span class="meta">{day.items.length}건</span>
        </div>
        {day.summary && <p class="summary">{day.summary}</p>}
        {day.items.length > 0 ? (
          <ol class="news-list">
            {day.items.map((it) => (
              <NewsItem
                title={it.title}
                href={it.url}
                source={it.src}
                sourceColor={SOURCE_COLOR[it.src]}
                score={it.score}
                domain={it.domain}
                comments={it.comments}
                publishedAt={it.publishedAt}
                fetchedAt={it.fetchedAt}
                date={day.date}
                discussionUrl={it.discussionUrl}
              />
            ))}
          </ol>
        ) : (
          <Empty
            id={`news-empty-${day.date}`}
            title={`${day.date} 링크가 없습니다`}
            description="요약은 보존됐지만 검증 가능한 외부 링크가 수집되지 않았습니다."
            href="/"
            action="최신 뉴스 보기"
          />
        )}
        {day.ideas.length > 0 && (
          <details class="ideas">
            <summary>💡 도출된 아이디어 {day.ideas.length}건</summary>
            <ul>
              {day.ideas.map((i) => (
                <li><b>{i.title}</b> — {i.hypothesis}</li>
              ))}
            </ul>
          </details>
        )}
      </section>
</BaseLayout>
