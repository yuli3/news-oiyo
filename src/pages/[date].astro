---
// 일자별 영구 URL. 홈은 최근 21일을 롤링으로만 보여주고 이전 글은 사라졌었다 —
// 이 페이지가 매일 생성한 요약·아이디어(원본 합성 콘텐츠, 단순 링크 목록이 아님)를
// 각각 고정 주소로 남겨 색인·인용 가능하게 만든다.
import data from "../data/news.json";
import Empty from "../components/Empty.astro";
import NewsItem from "../components/NewsItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOURCE_COLOR, metaDescriptionFromSummary, publicDaySummary, type Day, hasDetailPage } from "../lib/feed";

export async function getStaticPaths() {
  const days = data.days as Day[];
  // 2026-09-29: 날짜 페이지끼리 이전·다음으로 잇는다. 날짜 목록(/archive/)과 함께 고아를 없앤다.
  const sorted = [...days].sort((a, b) => a.date.localeCompare(b.date));
  return sorted.map((d, i) => ({
    params: { date: d.date },
    props: { day: d, prev: sorted[i - 1]?.date, next: sorted[i + 1]?.date },
  }));
}

const { day, prev, next } = Astro.props as { day: Day; prev?: string; next?: string };
const url = `https://news.oiyo.net/${day.date}/`;

const title = `${day.date} 기술·경제 트렌드 요약 — OIYO News`;
// 2026-10-06 (audit S5): internal agent memos in the day summary are not shown
// or indexed. A day left with no public summary and no links is noindexed.
const summary = publicDaySummary(day.summary);
const noindex = !summary && day.items.length === 0;
const description = metaDescriptionFromSummary(
  day.summary,
  `${day.date} 한국어로 고른 AI 링크. 원문 주소를 포함합니다.`,
);
---
<BaseLayout title={title} description={description} canonical={url} noindex={noindex} type="article" publishedTime={`${day.date}T00:00:00+09:00`} crumbs={[{ label: day.date }]}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      headline: title,
      datePublished: `${day.date}T00:00:00+09:00`,
      description,
      url,
      isPartOf: { "@id": "https://news.oiyo.net/#website" },
      publisher: { "@id": "https://oiyo.net/#organization" },
    })} /></Fragment>
    <style>
      .day-head {
        display: flex; align-items: baseline; gap: 10px;
        border-bottom: 2px solid var(--accent); padding-bottom: 6px; margin-bottom: 10px;
      }
      .day-head h1 { font-size: 20px; margin: 0; }
      .summary {
        background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--accent);
        border-radius: 10px; padding: 10px 14px; font-size: 13.5px; color: #4a4c42; margin-bottom: 12px;
      }
      .news-list { list-style:none; margin: 0; padding: 0; border-top:1px solid var(--border); }
      .meta { font-size: 12px; color: var(--muted); margin-left: 6px; white-space: nowrap; }
      .src { font-weight: 700; }
    </style>
      <section class="day">
        <div class="day-head">
          <h1>{day.date}</h1>
          <span class="meta">{day.items.length}건</span>
        </div>
        {summary && <p class="summary">{summary}</p>}
        {day.items.length > 0 ? (
          <ol class="news-list">
            {day.items.map((it) => (
              <NewsItem
                title={it.title}
                href={it.url}
                source={it.src}
                sourceColor={SOURCE_COLOR[it.src]}
                score={it.score}
                summary={it.summary}
                itemId={hasDetailPage(it) ? it.id : undefined}
                domain={it.domain}
                comments={it.comments}
                publishedAt={it.publishedAt}
                fetchedAt={it.fetchedAt}
                date={day.date}
                discussionUrl={it.discussionUrl}
              />
            ))}
          </ol>
        ) : (
          <Empty
            id={`news-empty-${day.date}`}
            title={`${day.date} 링크가 없습니다`}
            description="요약은 보존됐지만 검증 가능한 외부 링크가 수집되지 않았습니다."
            href="/"
            action="최신 뉴스 보기"
          />
        )}
        {/* 2026-10-06 (audit S5): "도출된 아이디어" are internal product ideas for
            OIYO sites written by the collection agent, not news. They stay in
            news.json for the brain but are no longer published. */}
      </section>
      <nav class="day-nav" aria-label="다른 날짜">
        {prev ? <a href={`/${prev}/`} rel="prev">← {prev}</a> : <span />}
        <a href="/archive/">날짜별 모아보기</a>
        {next ? <a href={`/${next}/`} rel="next">{next} →</a> : <span />}
      </nav>
      <style>
        .day-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 20px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 13.5px; }
      </style>
</BaseLayout>
