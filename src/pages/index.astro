---
// OIYO News — 날짜별 기술·경제 큐레이션과 시장 브리핑.
import data from "../data/news.json";
import Empty from "../components/Empty.astro";
import NewsItem from "../components/NewsItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type Item = { src: string; score: number | null; title: string; url: string; domain: string };
type Day = { date: string; summary: string; items: Item[]; ideas: { title: string; hypothesis: string }[] };
type MarketRow = { name: string; date?: string; last?: number; dayChange?: number; ret20?: number; vsMa20?: number; signal?: string };

const days = (data.days as Day[]).slice(0, 21);
const updated = data.generatedAt?.slice(0, 16).replace("T", " ") ?? "";
const market = (data as { market?: { generatedAt?: string; groups?: Record<string, MarketRow[]> } }).market ?? null;
const G = market?.groups ?? {};
const indices = G.indices ?? [];
// 테마별 접이식 섹션 (사용자 요청: AI 개별주식·AI ETF·월배당 개별주식·월배당 ETF)
const themed: { label: string; rows: MarketRow[] }[] = [
  { label: "🤖 AI 개별주식", rows: G.ai_stocks ?? [] },
  { label: "🤖 AI ETF", rows: G.ai_etf ?? [] },
  { label: "💰 월배당 개별주식", rows: G.monthly_div_stocks ?? [] },
  { label: "💰 월배당 ETF", rows: G.monthly_div_etf ?? [] },
  { label: "📊 관심 종목 · 배당 ETF", rows: [...(G.stocks ?? []), ...(G.dividend_etf ?? [])] },
].filter((s) => s.rows.length > 0);
const chg = (v?: number) => (v == null ? "" : `${v > 0 ? "+" : ""}${v.toFixed(2)}%`);
const tone = (v?: number) => (v == null || v === 0 ? "flat" : v > 0 ? "up" : "down");

// ── 오늘의 시장 브리핑 (룰 기반 사실 요약, 개인화 투자조언 아님) ──
const num = (v?: number) => (v == null ? 0 : v);
const briefDate = indices[0]?.date ?? updated.slice(0, 10);
const upN = indices.filter((r) => num(r.dayChange) > 0).length;
const downN = indices.filter((r) => num(r.dayChange) < 0).length;
const breadth = indices.length === 0 ? "" : upN > downN ? "위험 선호(상승 우위)" : downN > upN ? "위험 회피(하락 우위)" : "혼조";
const sorted = [...indices].sort((a, b) => num(b.dayChange) - num(a.dayChange));
const topUp = sorted[0];
const topDown = sorted[sorted.length - 1];
const aiRows = [...(G.ai_stocks ?? []), ...(G.ai_etf ?? [])];
const aiAvg = aiRows.length ? aiRows.reduce((s, r) => s + num(r.dayChange), 0) / aiRows.length : null;
const aboveMa = indices.filter((r) => num(r.vsMa20) > 0).length;
const trendNote = indices.length === 0 ? "" : aboveMa * 2 > indices.length
  ? `주요 지수 다수(${aboveMa}/${indices.length})가 20일 이동평균 위에 있어 단기 추세는 상승 우위로 관찰됩니다.`
  : `주요 지수 다수(${indices.length - aboveMa}/${indices.length})가 20일 이동평균 아래에 있어 단기 추세는 하락·조정 우위로 관찰됩니다.`;

const srcColor: Record<string, string> = {
  HN: "#ff6600",
  Lobsters: "#ac130d",
  GeekNews: "#0abf53",
};
---
<BaseLayout title="OIYO News — 데일리 기술·경제 큐레이션" description="디자인·코딩·AI·프로그래밍·경제·주식 뉴스를 매일 큐레이션하는 OIYO 뉴스. 미국·한국 증시 시그널 포함." canonical="https://news.oiyo.net/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","@id":"https://news.oiyo.net/#website",name:"OIYO News",url:"https://news.oiyo.net",publisher:{"@id":"https://oiyo.net/#organization"}})} /></Fragment>
    <style>
      .day { margin-bottom: 30px; }
      .day-head {
        display: flex; align-items: baseline; gap: 10px;
        border-bottom: 2px solid var(--accent); padding-bottom: 6px; margin-bottom: 10px;
      }
      .day-head h2 { font-size: 16px; margin: 0; }
      .summary {
        background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--accent);
        border-radius: 10px; padding: 10px 14px; font-size: 13.5px; color: #4a4c42; margin-bottom: 12px;
      }
      .news-list { margin: 0; padding-left: 24px; }
      .meta { font-size: 12px; color: var(--muted); margin-left: 6px; white-space: nowrap; }
      .src { font-weight: 700; }
      details.ideas { margin-top: 10px; font-size: 13px; }
      details.ideas summary { cursor: pointer; color: var(--accent); font-weight: 700; }
      details.ideas li { color: #4a4c42; }
      .brief {
        background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--accent);
        border-radius: 12px; padding: 12px 16px; margin: 4px 0 6px;
      }
      .brief h2 { font-size: 15px; margin: 0 0 6px; display: flex; align-items: baseline; gap: 8px; }
      .brief .bd { font-size: 12px; font-weight: 400; color: var(--muted); }
      .brief p { margin: 4px 0; font-size: 13.5px; color: #3f4138; }
      .brief .note { font-size: 11.5px; color: var(--muted); margin-top: 8px; }
      .market {
        display: flex; gap: 8px; overflow-x: auto; padding: 12px 0 4px; margin-bottom: 8px;
        -webkit-overflow-scrolling: touch;
      }
      .idx {
        flex: 0 0 auto; background: var(--card); border: 1px solid var(--border); border-radius: 12px;
        padding: 8px 12px; min-width: 128px;
      }
      .idx .n { font-size: 11px; font-weight: 700; color: var(--muted); }
      .idx .v { font-size: 15px; font-weight: 800; font-variant-numeric: tabular-nums; }
      .idx .c { font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; }
      .up { color: #dc2626; }   /* 한국 관례: 상승=빨강 */
      .down { color: #2563eb; }
      .flat { color: var(--muted); }
      .idx .s { font-size: 11px; color: var(--muted); }
      details.stocks { font-size: 13px; margin: 2px 0 18px; }
      details.stocks summary { cursor: pointer; color: var(--accent); font-weight: 700; }
      details.stocks table { width: 100%; border-collapse: collapse; margin-top: 8px; background: var(--card); border-radius: 10px; }
      details.stocks th, details.stocks td { text-align: right; padding: 5px 10px; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
      details.stocks th:first-child, details.stocks td:first-child { text-align: left; }
      .radar-home-link { margin: 12px 0 0; font-size: 14px; font-weight: 700; min-height: 44px; display: flex; align-items: center; }
      .radar-home-link a { text-decoration: none; }
      .radar-home-link a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    </style>
    <div class="page-intro"><p class="eyebrow">sync {updated}</p><h1>기술·경제의 오늘과<br />AI 시스템의 맥락</h1><p class="lede">HN·Lobsters·GeekNews에서 검증 가능한 링크를 모으고, 시장 흐름과 AI-native 운영 지식을 구분해 정리합니다.</p><p class="radar-home-link"><a href="/radar/">레이더 — 디자인 갤러리와 엔지니어링 선반</a></p></div>
      {indices.length > 0 && (
        <>
          <section class="brief">
            <h2>📌 오늘의 시장 브리핑 <span class="bd">{briefDate}</span></h2>
            <p>
              주요 지수 {indices.length}개 중 <b class="up">{upN} 상승</b> · <b class="down">{downN} 하락</b>{breadth && <> — {breadth}</>}.
              {topUp && <> 최강 <b>{topUp.name}</b> <span class={tone(topUp.dayChange)}>{chg(topUp.dayChange)}</span>.</>}
              {topDown && topDown !== topUp && <> 최약 <b>{topDown.name}</b> <span class={tone(topDown.dayChange)}>{chg(topDown.dayChange)}</span>.</>}
            </p>
            {aiAvg != null && (
              <p>🤖 AI 섹터({aiRows.length}종목) 평균 일간 <b class={tone(aiAvg)}>{chg(aiAvg)}</b>.</p>
            )}
            {trendNote && <p>📈 {trendNote}</p>}
            <p class="note">※ 종가·이동평균 기반의 사실 요약이며 개인화된 투자 권유가 아닙니다. 원자료: 공개 시장 데이터 · 기준일 {briefDate}.</p>
          </section>
          <div class="market">
            {indices.map((r) => (
              <div class="idx">
                <div class="n">{r.name} <span style="font-weight:400">{r.date?.slice(5)}</span></div>
                <div class="v">{r.last?.toLocaleString()}</div>
                <div class={`c ${tone(r.dayChange)}`}>{chg(r.dayChange)} <span class="s">/ 20d {chg(r.ret20)}</span></div>
                {r.signal && <div class="s">{r.signal}</div>}
              </div>
            ))}
          </div>
          {themed.map((sec) => (
            <details class="stocks">
              <summary>{sec.label} {sec.rows.length}</summary>
              <table>
                <thead><tr><th>종목</th><th>종가</th><th>일간</th><th>20일</th><th>vs MA20</th><th>시그널</th></tr></thead>
                <tbody>
                  {sec.rows.map((r) => (
                    <tr>
                      <td>{r.name}</td>
                      <td>{r.last?.toLocaleString()}</td>
                      <td class={tone(r.dayChange)}>{chg(r.dayChange)}</td>
                      <td class={tone(r.ret20)}>{chg(r.ret20)}</td>
                      <td class={tone(r.vsMa20)}>{chg(r.vsMa20)}</td>
                      <td style="text-align:left">{r.signal ?? ""}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          ))}
        </>
      )}
      {days.length === 0 && <Empty id="news-empty-home" />}
      {days.map((d) => (
        <section class="day">
          <div class="day-head">
            <h2><a href={`/${d.date}/`} style="color:inherit;text-decoration:none">{d.date}</a></h2>
            <span class="meta">{d.items.length}건</span>
          </div>
          {d.summary && <p class="summary">{d.summary}</p>}
          {d.items.length > 0 ? (
            <ol class="news-list">
              {d.items.map((it) => (
                <NewsItem
                  title={it.title}
                  href={it.url}
                  source={it.src}
                  sourceColor={srcColor[it.src]}
                  score={it.score}
                  domain={it.domain}
                />
              ))}
            </ol>
          ) : (
            <Empty
              id={`news-empty-${d.date}`}
              title={`${d.date} 링크가 없습니다`}
              description="요약은 보존됐지만 검증 가능한 외부 링크가 수집되지 않았습니다."
              href="/"
              action="최신 뉴스 보기"
            />
          )}
          {d.ideas.length > 0 && (
            <details class="ideas">
              <summary>💡 도출된 아이디어 {d.ideas.length}건</summary>
              <ul>
                {d.ideas.map((i) => (
                  <li><b>{i.title}</b> — {i.hypothesis}</li>
                ))}
              </ul>
            </details>
          )}
        </section>
      ))}
    <style>.page-intro{padding:16px 0 28px}.eyebrow{color:var(--accent);font-size:12px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.page-intro h1{max-width:720px}.page-intro .lede{margin-bottom:0}</style>
</BaseLayout>
