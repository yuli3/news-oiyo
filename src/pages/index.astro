---
import data from "../data/news.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import TopicNav from "../components/TopicNav.astro";
import TopicFeed from "../components/TopicFeed.astro";
import ShowcaseWeeklyCard from "../components/ShowcaseWeeklyCard.astro";
import { flattenFeed,type Day } from "../lib/feed";
import { storySections } from "../../scripts/lib/story-scope.mjs";
const feed=flattenFeed(data.days as Day[]);
const ai=feed.filter(item=>storySections(item).includes("ai"));
const finance=feed.filter(item=>storySections(item).includes("finance"));
---
<BaseLayout title="OIYO News — AI와 금융 소식을 한눈에" description="AI 모델·도구 소식과 금융 뉴스·시장 브리핑을 출처와 함께 읽어요. 관심 분야를 골라 바로 시작하세요." canonical="https://news.oiyo.net/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","@id":"https://news.oiyo.net/#website",name:"OIYO News",url:"https://news.oiyo.net",publisher:{"@id":"https://oiyo.net/#organization"}})} /></Fragment>
  <div class="page-intro"><h1>AI와 금융 소식을<br />출처와 함께 읽어요.</h1><p class="lede">새 모델과 도구가 궁금하다면 AI, 시장 흐름이 궁금하다면 금융을 골라 주세요.</p><TopicNav /></div>
  <div class="desks">
    <section aria-labelledby="ai-heading"><h2 id="ai-heading"><a href="/ai/">AI 뉴스</a></h2><p class="desk-intro">모델 발표와 실무 도구, 기술 변화의 맥락을 살펴봐요.</p><TopicFeed items={ai.slice(0,8)} label="최신 AI 뉴스" filters /><a class="more" href="/ai/">AI 뉴스·분석 더 보기</a></section>
    <section aria-labelledby="finance-heading"><h2 id="finance-heading"><a href="/finance/">금융 뉴스</a></h2><p class="desk-intro">시장 브리핑과 금리·환율·기업 소식을 살펴봐요. 투자 권유는 아니에요.</p><TopicFeed items={finance.slice(0,5)} label="최근 금융 뉴스" /><a class="more" href="/finance/">금융 뉴스·시장 브리핑 보기</a></section>
  </div>
  <ShowcaseWeeklyCard />
  <p class="archive-link"><a href="/page/1/">전체 기사 목록</a> · <a href="/archive/">날짜별 전체 기사 보기</a><br />두 분야에 걸친 기사는 각각의 섹션에서 볼 수 있어요.</p>
  <style>
    .page-intro{padding:24px 0 0}.page-intro h1{max-width:24ch;font-size:clamp(30px,5vw,44px);line-height:1.35;margin:0 0 12px;letter-spacing:-.03em}.page-intro .lede{max-width:60ch;margin:0;font-size:16px}
    .desks{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:32px}.desks section{min-width:0}.desks h2{margin:0 0 12px}.desks h2 a{color:var(--ink);text-decoration:none}.desk-intro{font-size:14px;color:var(--muted);margin:0 0 16px}
    .more{display:inline-flex;align-items:center;min-height:44px;color:var(--accent);font-weight:700;text-underline-offset:3px}.archive-link{margin-top:32px;color:var(--muted);font-size:14px}
    @media(max-width:720px){.desks{grid-template-columns:1fr;gap:36px}.page-intro{padding-top:18px}}
  </style>
</BaseLayout>
