---
// 페이지 2부터의 랜딩 페이지네이션. /page/N/ 정적 생성.
import data from "../../data/news.json";
import Empty from "../../components/Empty.astro";
import NewsItem from "../../components/NewsItem.astro";
import Pager from "../../components/Pager.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { flattenFeed, pageCount, ITEMS_PER_PAGE, SOURCE_COLOR, type Day } from "../../lib/feed";

const feed = flattenFeed(data.days as Day[]);
const totalPages = pageCount(feed.length);

export function getStaticPaths() {
  const all = flattenFeed(data.days as Day[]);
  const total = pageCount(all.length);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { pageNum: i + 1 },
  }));
}

const { pageNum } = Astro.props as { pageNum: number };
const items = feed.slice(pageNum * ITEMS_PER_PAGE, (pageNum + 1) * ITEMS_PER_PAGE);
const title = `기술·경제 트렌드 아카이브 ${pageNum + 1}페이지 — OIYO News`;
---
<BaseLayout title={title} description="HN·Lobsters·GeekNews·TechCrunch 등에서 수집한 기술·경제 큐레이션 아카이브." canonical={`https://news.oiyo.net/page/${pageNum + 1}/`}>
  <div class="page-intro"><p class="eyebrow">archive</p><h1>지난 트렌드 — {pageNum + 1} / {totalPages} 페이지</h1><p class="lede">최신 피드는 <a href="/">1페이지</a>에 있습니다.</p></div>
      {items.length === 0 && <Empty id="news-empty-archive" />}
      {items.length > 0 && (
        <ol class="news-board">
          {items.map((it) => (
            <NewsItem
              title={it.title}
              href={it.url}
              source={it.src}
              sourceColor={SOURCE_COLOR[it.src]}
              score={it.score}
              domain={it.domain}
              comments={it.comments}
              publishedAt={it.publishedAt}
              fetchedAt={it.fetchedAt}
              date={it.date}
              discussionUrl={it.discussionUrl}
            />
          ))}
        </ol>
      )}
    <Pager pageNum={pageNum} totalPages={totalPages} />
    <style>
      .page-intro{padding:16px 0 20px}
      .eyebrow{color:var(--accent);font-size:12px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
      .news-board{list-style:none;margin:8px 0 0;padding:0;border-top:1px solid var(--border)}
    </style>
</BaseLayout>
