---
// 페이지 2부터의 랜딩 페이지네이션. /page/N/ 정적 생성.
import data from "../../data/news.json";
import Empty from "../../components/Empty.astro";
import NewsItem from "../../components/NewsItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageHref } from "../../lib/pager";

type Item = { src: string; score: number | null; title: string; url: string; domain: string };
type Day = { date: string; summary: string; items: Item[]; ideas: { title: string; hypothesis: string }[] };

const DAYS_PER_PAGE = 7;
const allDays = data.days as Day[];
const totalPages = Math.max(1, Math.ceil(allDays.length / DAYS_PER_PAGE));

export function getStaticPaths() {
  const total = Math.max(1, Math.ceil((data.days as unknown[]).length / 7));
  return Array.from({ length: total - 1 }, (_, i) => ({ params: { page: String(i + 2) }, props: { pageNum: i + 1 } }));
}

const { pageNum } = Astro.props as { pageNum: number };
const days = allDays.slice(pageNum * DAYS_PER_PAGE, (pageNum + 1) * DAYS_PER_PAGE);
const srcColor = { HN: "#ff6600", Lobsters: "#ac130d", GeekNews: "#0abf53" };
const title = `기술·경제 트렌드 아카이브 ${pageNum + 1}페이지 — OIYO News`;
---
<BaseLayout title={title} description="HN·Lobsters·GeekNews·TechCrunch 등에서 수집한 기술·경제 데일리 큐레이션 아카이브." canonical={`https://news.oiyo.net/page/${pageNum + 1}/`}>
  <div class="page-intro"><p class="eyebrow">archive</p><h1>지난 트렌드 — {pageNum + 1} / {totalPages} 페이지</h1><p class="lede">최신 피드는 <a href="/">1페이지</a>에 있습니다.</p></div>
      {days.length === 0 && <Empty id="news-empty-archive" />}
      {days.map((d) => (
        <section class="day">
          <div class="day-head">
            <h2><a href={`/${d.date}/`} style="color:inherit;text-decoration:none">{d.date}</a></h2>
            <span class="meta">{d.items.length}건</span>
          </div>
          {d.summary && <p class="summary">{d.summary}</p>}
          {d.items.length > 0 ? (
            <ol class="news-list">
              {d.items.map((it) => (
                <NewsItem
                  title={it.title}
                  href={it.url}
                  source={it.src}
                  sourceColor={srcColor[it.src]}
                  score={it.score}
                  domain={it.domain}
                />
              ))}
            </ol>
          ) : (
            <Empty id={`news-empty-${d.date}`} title={`${d.date} 링크가 없습니다`} description="요약은 보존됐지만 검증 가능한 외부 링크가 수집되지 않았습니다." href="/" action="최신 뉴스 보기" />
          )}
        </section>
      ))}
    <style>.page-intro{padding:16px 0 28px}.eyebrow{color:var(--accent);font-size:12px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.pager{display:flex;justify-content:center;gap:6px;flex-wrap:wrap;margin:26px 0 8px}.pager a,.pager span.cur{min-width:38px;padding:8px 10px;text-align:center;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;border:1px solid var(--border)}.pager a:hover{border-color:var(--accent);color:var(--accent)}.pager span.cur{background:var(--accent);color:#fff;border-color:var(--accent)}.pager .lbl{font-size:12px;color:var(--muted);align-self:center;margin-right:6px}</style>
      <nav class="pager" aria-label="페이지 탐색">
        <span class="lbl">{pageNum + 1} / {totalPages} 페이지</span>
        {Array.from({ length: totalPages }, (_, i) =>
          i === pageNum
            ? <span class="cur" aria-current="page">{i + 1}</span>
            : <a href={pageHref(i)}>{i + 1}</a>
        )}
      </nav>
</BaseLayout>
