---
import AiLocaleLayout from "../../../layouts/AiLocaleLayout.astro";
import PricingView from "../../../components/ai/PricingView.astro";
import { API_MODELS, PRICING_CHECKED } from "../../../data/ai-pricing";
import { PRICING_LOCALES } from "../../../data/ai-pricing-locales";
import { LOCALES, UI, allPaths, hubPath, pricingPath, type Locale } from "../../../data/ai-i18n";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== "ko").map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Exclude<Locale, "ko">;
const t = UI[lang];
const data = PRICING_LOCALES[lang];
const description = `${t.pricingLede} ${t.checkedOn} ${PRICING_CHECKED}.`;
const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t.pricingTitle,
  description,
  datePublished: PRICING_CHECKED,
  dateModified: PRICING_CHECKED,
  inLanguage: lang === "zh" ? "zh-CN" : lang,
  author: { "@type": "Organization", name: "OIYO News", url: "https://news.oiyo.net/" },
  citation: [...new Set([...data.vendors.flatMap((v) => v.sources.map((s) => s.url)), ...API_MODELS.map((m) => m.source)])],
};
---
<AiLocaleLayout lang={lang} title={t.pricingTitle} description={description} paths={allPaths(pricingPath)} crumbs={[{ label: t.useCasesShort, href: hubPath(lang) }, { label: t.pricingShort }]} jsonLd={[article]} published={PRICING_CHECKED}>
  <h1>{t.pricingH1}</h1>
  <PricingView lang={lang} vendors={data.vendors} bands={data.bands} localApi={data.localApi} />
</AiLocaleLayout>
