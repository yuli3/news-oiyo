---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PRACTICAL_TOOL_GROUPS } from "../../data/practical-tools";

// 실무 편입 도구는 통합 AI 큐레이터(/ai/curator/)로 합쳐졌다.
// 이 페이지는 URL을 살려두는 안내 포인터다 — 데이터 본체는 curator에서 렌더링한다.
const total = PRACTICAL_TOOL_GROUPS.reduce((n, g) => n + g.items.length, 0);
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: "https://news.oiyo.net/" },
    { "@type": "ListItem", position: 2, name: "AI", item: "https://news.oiyo.net/ai/" },
    { "@type": "ListItem", position: 3, name: "실무 도구", item: "https://news.oiyo.net/ai/tools/" },
  ],
};
---

<BaseLayout
  title="AI 서비스 큐레이션 — AI 큐레이터로 통합되었습니다"
  description="OIYO 운영에서 사용하거나 검토한 도구 목록은 AI 큐레이터(/ai/curator/)의 도구 섹션으로 통합되었습니다."
  canonical="https://news.oiyo.net/ai/tools/"
  crumbs={[{label:"AI",href:"/ai/"},{label:"실무 도구"}]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <span class="tag">Moved</span>
  <h1>실무 도구 → AI 큐레이터</h1>
  <p class="sub">
    광고·제휴 없음. OIYO 운영에서 사용하거나 검토한 도구 {total}개는 이제
    <a href="/ai/curator/">AI 큐레이터</a>의 <b>도구</b> 섹션에 있습니다.
    각 항목에는 실제 활용 맥락과 선택 이유를 간단히 정리했습니다.
  </p>
  <div class="doc-grid">
    {PRACTICAL_TOOL_GROUPS.map((g) => (
      <a class="doc-link" href={`/ai/curator/#${g.id}`}>
        <strong>{g.label}</strong>
        <span>{g.items.map((t) => t.name).join(" · ")}</span>
      </a>
    ))}
    <a class="doc-link" href="/ai/faq/"><strong>AI 활용 FAQ</strong><span>AX·에이전트·비용·보안 18문답</span></a>
  </div>
</BaseLayout>
