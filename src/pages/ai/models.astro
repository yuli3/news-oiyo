---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MODEL_GROUPS, LEADERBOARDS, MODELS_UPDATED } from "../../data/ai-models";

// 모델 카탈로그는 통합 AI 큐레이터(/ai/curator/)로 합쳐졌다.
// 이 페이지는 URL을 살려두는 안내 포인터다 — 데이터 본체는 curator에서 렌더링한다.
const total = MODEL_GROUPS.reduce((n, g) => n + g.items.length, 0);
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: "https://news.oiyo.net/" },
    { "@type": "ListItem", position: 2, name: "AI", item: "https://news.oiyo.net/ai/" },
    { "@type": "ListItem", position: 3, name: "모델 카탈로그", item: "https://news.oiyo.net/ai/models/" },
  ],
};
---

<BaseLayout
  title="AI 모델 카탈로그 — AI 큐레이터로 통합되었습니다"
  description="프론티어·오픈웨이트 모델 카탈로그와 라이브 리더보드는 AI 큐레이터(/ai/curator/)로 통합되었습니다."
  canonical="https://news.oiyo.net/ai/models/"
  crumbs={[{label:"AI",href:"/ai/"},{label:"모델 카탈로그"}]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <span class="tag">Moved</span>
  <h1>AI 모델 카탈로그 → AI 큐레이터</h1>
  <p class="lede">
    모델 카탈로그(프론티어·오픈웨이트·로컬 런타임, 총 {total}개)는 이제
    <a href="/ai/curator/">AI 큐레이터</a> 한 곳에 통합됐습니다. 아래 섹션으로 바로 이동하세요.
    확인일자 {MODELS_UPDATED}.
  </p>
  <div class="doc-grid">
    {MODEL_GROUPS.map((g) => (
      <a class="doc-link" href={`/ai/curator/#${g.id}`}>
        <strong>{g.label}</strong>
        <span>{g.desc}</span>
      </a>
    ))}
    <a class="doc-link" href="/ai/curator/#leaderboards"><strong>라이브 리더보드</strong><span>LMArena·Artificial Analysis 등 실시간 순위 {LEADERBOARDS.length}곳</span></a>
    <a class="doc-link" href="/ai/data/ai-models.json"><strong>ai-models.json</strong><span>기계가 읽는 원본 데이터 (CC BY 4.0)</span></a>
    <a class="doc-link" href="/ai/faq/"><strong>AI 활용 FAQ</strong><span>AX·에이전트·비용·보안 18문답</span></a>
  </div>
</BaseLayout>
