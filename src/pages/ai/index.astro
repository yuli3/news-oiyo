---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopicNav from "../../components/TopicNav.astro";
import TopicFeed from "../../components/TopicFeed.astro";
import RepoList from "../../components/RepoList.astro";
import AiPriceTracker from "../../components/AiPriceTracker.astro";
import data from "../../data/news.json";
import { flattenFeed,splitDayItems,type Day } from "../../lib/feed";
import { storySections } from "../../../scripts/lib/story-scope.mjs";
const days=data.days as Day[];
const items=flattenFeed(days).filter(item=>storySections(item).includes("ai"));
const repoDay=days.find(day=>splitDayItems(day.items).repos.length>0);
---
<BaseLayout title="AI 뉴스·모델·도구" description="최신 AI 소식부터 모델·도구 비교, 가격·성능 분석과 활용 자료까지 출처와 함께 살펴봐요." canonical="https://news.oiyo.net/ai/" crumbs={[{label:"AI"}]}>
  <h1>AI 소식과 활용 자료</h1><p class="lede">새 모델과 도구의 변화부터 가격·성능을 읽는 기준까지 살펴봐요.</p><TopicNav />
  <nav class="reading-links" aria-label="AI 참고자료">{[["/ai/wow/","AI로 만든 놀라운 것","매주 N선, 원문 링크"],["/ai/pricing/","구독료·API 비용 비교","요금제와 토큰 단가"],["/ai/use-cases/","분야별 AI 활용","직군별 실제 쓰임"],["/analysis/","가격·성능 분석","모델 성능 대비 비용"],["/ai/curator/","모델·도구 큐레이터","목적별 추천"],["/ai/faq/","활용 FAQ","자주 묻는 질문"],["/systems/","AI 운영 시스템","팀에 붙이는 방법"]].map(([href,name,hint]) => <a href={href}><strong>{name}</strong><span>{hint}</span></a>)}</nav>
  <h2>최근 AI 뉴스</h2><TopicFeed items={items.slice(0,30)} label="AI 뉴스" filters /><p><a href="/archive/">이전 날짜의 기사 보기</a> · <a href="/ai/rss.xml">AI 뉴스 RSS</a></p>
  <AiPriceTracker />
  {repoDay&&<RepoList repos={splitDayItems(repoDay.items).repos} date={repoDay.date} moreHref={`/${repoDay.date}/`} />}
  <style>.reading-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:8px 0 4px}.reading-links a{display:flex;flex-direction:column;gap:2px;min-height:44px;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--card);color:var(--ink);text-decoration:none}.reading-links a:hover{border-color:var(--accent)}.reading-links strong{font-size:14.5px;line-height:1.35}.reading-links span{font-size:12.5px;color:var(--muted)}@media(max-width:640px){.reading-links{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
</BaseLayout>
