---
// 2026-10-13 커뮤니티 게시판. 글은 사용자 생성 콘텐츠라 noindex(광고도 붙지 않음).
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/community.css";
---
<BaseLayout title="커뮤니티" description="OIYO News 독자 커뮤니티" noindex crumbs={[{ label: "커뮤니티" }]}>
  <div class="bd-head">
    <h1 class="bd-h1">커뮤니티</h1>
    <button type="button" class="cm-submit" id="bd-write" hidden>글쓰기</button>
  </div>
  <p class="cm-note">기술·경제 뉴스 이야기를 나누는 곳이에요. 광고·욕설·개인정보 노출은 신고되면 가려져요.</p>
  <div id="bd-compose"></div>
  <nav class="bd-tabs" aria-label="글 분류">
    <button type="button" class="cm-btn" data-cat="" aria-pressed="true">전체</button>
    <button type="button" class="cm-btn" data-cat="free" aria-pressed="false">자유</button>
    <button type="button" class="cm-btn" data-cat="question" aria-pressed="false">질문</button>
    <button type="button" class="cm-btn" data-cat="share" aria-pressed="false">정보 공유</button>
    <span class="bd-sep"></span>
    <button type="button" class="cm-btn" data-sort="new" aria-pressed="true">최신</button>
    <button type="button" class="cm-btn" data-sort="top" aria-pressed="false">추천순</button>
  </nav>
  <ol id="bd-list" class="bd-list" aria-live="polite"><li class="cm-empty">불러오고 있어요…</li></ol>
  <div class="bd-more"><button type="button" class="cm-btn" id="bd-more" hidden>더 보기</button></div>
  <script>
    import { ApiError, CATEGORY_LABEL, api, attachTurnstile, el, getConfig, getMe, loginHref, timeAgo, type PostSummary } from "../../lib/community";
    const list = document.getElementById("bd-list")!;
    const more = document.getElementById("bd-more") as HTMLButtonElement;
    const write = document.getElementById("bd-write") as HTMLButtonElement;
    const compose = document.getElementById("bd-compose")!;
    let cat = "", sort = "new", page = 1;

    async function load(reset: boolean) {
      if (reset) page = 1;
      try {
        const q = new URLSearchParams({ sort, page: String(page) });
        if (cat) q.set("category", cat);
        const d = await api<{ posts: PostSummary[]; hasMore: boolean }>("GET", `/api/posts?${q}`);
        const rows = d.posts.map((p) =>
          el("li", { class: "bd-row" },
            el("a", { class: "bd-link", href: `/community/post/?id=${encodeURIComponent(p.id)}` },
              el("span", { class: "bd-cat", text: CATEGORY_LABEL[p.category] ?? p.category }),
              el("span", { class: "bd-title", text: p.title }),
              p.comments ? el("span", { class: "bd-cmt", text: `[${p.comments}]` }) : null,
            ),
            el("span", { class: "bd-meta", text: `${p.author} · ${timeAgo(p.createdAt)} · 👍 ${p.score}` }),
          ));
        if (reset) list.replaceChildren(...rows);
        else list.append(...rows);
        if (reset && rows.length === 0) list.replaceChildren(el("li", { class: "cm-empty", text: "아직 글이 없어요. 첫 글을 남겨 보세요." }));
        more.hidden = !d.hasMore;
      } catch (e) {
        list.replaceChildren(el("li", { class: "cm-empty", text: e instanceof ApiError && e.status === 503 ? "커뮤니티를 준비하고 있어요. 곧 글을 쓸 수 있어요." : "글을 불러오지 못했어요." }));
      }
    }

    function press(sel: string, btn: HTMLElement) {
      for (const b of document.querySelectorAll(sel)) b.setAttribute("aria-pressed", String(b === btn));
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-cat]")) b.addEventListener("click", () => { cat = b.dataset.cat!; press("[data-cat]", b); load(true); });
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-sort]")) b.addEventListener("click", () => { sort = b.dataset.sort!; press("[data-sort]", b); load(true); });
    more.addEventListener("click", () => { page++; load(false); });

    async function setupWrite() {
      const [config, me] = await Promise.all([getConfig(), getMe()]);
      write.hidden = false;
      write.addEventListener("click", () => {
        if (compose.firstChild) { compose.replaceChildren(); return; }
        if (!config.enabled) {
          compose.replaceChildren(el("p", { class: "cm-note", role: "status", text: "커뮤니티를 준비하고 있어요. 곧 글을 쓸 수 있어요." }));
          return;
        }
        if (!me) {
          compose.replaceChildren(el("div", { class: "cm-form cm-login" },
            el("p", { text: "글을 쓰려면 로그인해 주세요." }),
            el("div", { class: "cm-providers" }, ...(config.providers ?? []).map((p) => el("a", { class: `cm-provider cm-provider-${p.id}`, href: loginHref(p.id), text: `${p.label}로 로그인` })))));
          return;
        }
        const category = el("select", { class: "cm-field", "aria-label": "분류" }, ...Object.entries(CATEGORY_LABEL).map(([v, t]) => el("option", { value: v, text: t })));
        const title = el("input", { class: "cm-field", maxlength: "80", placeholder: "제목", "aria-label": "제목" });
        const body = el("textarea", { class: "cm-input", rows: "8", maxlength: "5000", placeholder: "내용을 써 주세요. 가입하고 하루가 지나면 링크를 2개까지 달 수 있어요.", "aria-label": "내용" });
        const ts = el("div", { class: "cm-turnstile" });
        const status = el("span", { class: "cm-status", role: "status" });
        const submit = el("button", { type: "submit", class: "cm-submit", text: "올리기" });
        const form = el("form", { class: "cm-form bd-form" }, category, title, body, ts, el("div", { class: "cm-row" }, status, submit));
        const turnstile = attachTurnstile(ts);
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          submit.disabled = true;
          try {
            const r = await api<{ id: string }>("POST", "/api/posts", { category: category.value, title: title.value, body: body.value, turnstileToken: turnstile.token() });
            location.href = `/community/post/?id=${encodeURIComponent(r.id)}`;
          } catch (err) {
            status.textContent = err instanceof ApiError ? err.message : "올리지 못했어요.";
            submit.disabled = false;
            turnstile.reset();
          }
        });
        compose.replaceChildren(form);
        title.focus();
      });
    }
    setupWrite();
    load(true);
  </script>
  <style>
    .bd-head { display:flex; align-items:center; justify-content:space-between; gap:12px }
    .bd-h1 { font-size:22px; margin:0 }
    .bd-tabs { display:flex; flex-wrap:wrap; gap:6px; margin:14px 0 8px; align-items:center }
    .bd-sep { flex:1 }
    .bd-list { list-style:none; margin:0; padding:0; border-top:1px solid var(--border) }
    .bd-list :global(.bd-row) { padding:12px 2px; border-bottom:1px solid var(--border); display:flex; flex-direction:column; gap:3px }
    .bd-list :global(.bd-link) { color:var(--ink); text-decoration:none; font-weight:700; display:flex; gap:8px; align-items:baseline; overflow-wrap:anywhere }
    .bd-list :global(.bd-link:hover) { color:var(--accent) }
    .bd-list :global(.bd-cat) { flex:none; font-size:11.5px; font-weight:800; color:var(--accent); background:var(--accent-soft); border-radius:999px; padding:1px 8px }
    .bd-list :global(.bd-cmt) { color:var(--accent); font-size:13px }
    .bd-list :global(.bd-meta) { font-size:12px; color:var(--muted) }
    .bd-more { text-align:center; margin-top:14px }
  </style>
</BaseLayout>
