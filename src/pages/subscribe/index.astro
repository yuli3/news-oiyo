---
import BaseLayout from "../../layouts/BaseLayout.astro";
// 이 경로는 정적 HTML이다. ?status= 는 빌드 때 없고, 브라우저가 주소에서 읽는다 (2026-10-14).

---

<BaseLayout
  title="뉴스 메일"
  description="세계 AI 거장들의 글과 지금 뜨는 AI 소식을 매주 한국어로 골라 보내요. 무료이고, 확인 메일의 링크를 눌러야 구독이 시작돼요."
  crumbs={[{ label: "뉴스 메일" }]}
>
  <h1>세계 AI 거장들의 생각, 매주 가장 빠르게 받아 보세요</h1>
  <p class="lede">OpenAI·Google DeepMind·안드레이 카르파시가 직접 쓴 글부터 해커뉴스·GeekNews·X에서 지금 뜨는 이야기까지. 지난 7일의 AI 흐름과 핵심 인사이트를 한국어로 골라 매주 한 통에 담아 보내요. 놓치면 아쉬운 소식만 모았어요.</p>
  <ul class="mail-points">
    <li>매주 한 번, 지난 7일의 AI 핵심만 한 통으로</li>
    <li>AI를 만드는 사람들이 직접 쓴 글을 한국어 요약으로</li>
    <li>무료예요. 메일마다 한 번에 해지할 수 있어요</li>
  </ul>
  <p class="mail-fine">AI 소식과 함께 금융 소식도 일부 담겨요. 그 주에 보낼 내용이 없으면 쉬고, 확인을 마친 주소로만 보내요. 개인화된 투자 권유는 아니에요.</p>
  <form class="mail-form" method="post" action="/api/mailing-list/subscribe">
    <label class="mail-field" for="email">이메일
      <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" />
    </label>
    <label class="mail-check">
      <input name="consent" type="checkbox" value="on" required />
      <span>AI·금융 소식 메일 수신에 동의합니다. 메일마다 수신 거부 링크가 있어요.</span>
    </label>
    <div class="mail-trap" aria-hidden="true">
      <label>회사<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    <button class="mail-submit" type="submit">무료로 매주 받아 보기</button>
    <p id="mail-status" class="mail-status" role="status" aria-live="polite"></p>
  </form>
  <section class="card">
    <h2>저장하는 것</h2>
    <p>정책 버전은 2026-10-15예요. 이메일 주소와 동의 시각, 발송 처리 기록과 남용 방지용 해시를 저장해요. 확인하지 않은 신청은 신청 후 7일이 지나면 시간 단위 정리 작업에서 삭제해요. 확인 링크는 48시간 동안 유효해요. 활성 구독 정보는 해지할 때까지 유지해요.</p>
    <p>해지하면 운영 DB의 이메일 원문, 확인·해지 토큰과 해당 주소의 발송 처리 기록을 삭제해요. 재발송 방지를 위해 키 기반 해시와 해지 시각만 90일간 보관한 뒤 시간 단위 정리 작업에서 삭제해요. 이 해시도 개인정보성 기록으로 관리하며, 이 기간에는 다시 신청해도 확인 메일을 보내지 않아요.</p>
    <p>발송 중복 방지 기록은 최대 7일, 개인 주소가 없는 주간 호 정보는 최대 14일 보관해요. 남용 방지용 해시는 제한 기간 만료 후 정리해요. 발송 중인 메일을 해지로 회수할 수는 없어요. 발송 처리에는 Resend, 저장에는 Cloudflare를 사용하며 공급자의 발송 로그·복구 백업은 운영 DB 삭제와 별도로 관리돼요. 주소를 팔지 않아요. 문의: <a href="mailto:support@oiyo.net">support@oiyo.net</a></p>
    <p>확인 메일을 보낼 발송 계정이 연결된 서버에서만 신청을 저장해요. 연결 전에는 주소를 저장하지 않아요.</p>
    <p>보내는 이: OIYO News · <a href="https://news.oiyo.net/">news.oiyo.net</a></p>
    <p><a href="https://blog.oiyo.net/ko/privacy/">개인정보 처리방침</a></p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var messages = {
      check_inbox: "메일함을 확인해 주세요. 확인 메일의 링크를 눌러야 구독이 시작돼요. 이미 구독 중이라면 새 확인 메일은 보내지 않아요.",
      consent_required: "수신 동의에 체크해야 신청할 수 있어요.",
      invalid_email: "이메일 주소를 다시 확인해 주세요.",
      rate_limited: "잠시 뒤에 다시 시도해 주세요.",
      mailer_unconfigured: "확인 메일을 보낼 발송 계정이 아직 없어요. 주소는 저장하지 않았어요.",
      store_unconfigured: "구독 저장소가 아직 연결되지 않았어요. 주소는 저장하지 않았어요.",
      send_failed: "발송 결과를 확인하지 못했어요. 대기 중인 신청이 남아 있을 수 있어요. 잠시 후 메일함을 확인해 주세요.",
      confirmation_unconfigured: "안전한 확인 메일 설정이 아직 준비되지 않았어요. 주소는 저장하지 않았어요.",
      confirmation_review_required: "확인 메일 상태를 점검해야 해요. 반복 신청하지 말고 운영자에게 문의해 주세요.",
      service_unavailable: "처리 결과를 확인하지 못했어요. 메일함을 확인한 뒤 잠시 후 다시 시도해 주세요.",
      state_changed: "신청 상태가 바뀌었어요. 메일함을 확인해 주세요."
    };
    var status = new URLSearchParams(location.search).get("status") || "";
    var el = document.getElementById("mail-status");
    if (el && messages[status]) el.textContent = messages[status];
  })();
</script>

<script>
  const form = document.querySelector(".mail-form");
  const status = document.querySelector("#mail-status");
  const messages = {
    check_inbox: "메일함을 확인해 주세요. 확인 메일의 링크를 눌러야 구독이 시작돼요. 이미 구독 중이라면 새 확인 메일은 보내지 않아요.",
    consent_required: "수신 동의에 체크해야 신청할 수 있어요.",
    invalid_email: "이메일 주소를 다시 확인해 주세요.",
    rate_limited: "잠시 뒤에 다시 시도해 주세요.",
    mailer_unconfigured: "확인 메일을 보낼 발송 계정이 아직 없어요. 주소는 저장하지 않았어요.",
    store_unconfigured: "구독 저장소가 아직 연결되지 않았어요. 주소는 저장하지 않았어요.",
    send_failed: "발송 결과를 확인하지 못했어요. 대기 중인 신청이 남아 있을 수 있어요. 잠시 후 메일함을 확인해 주세요.",
    confirmation_unconfigured: "안전한 확인 메일 설정이 아직 준비되지 않았어요. 주소는 저장하지 않았어요.",
    confirmation_review_required: "확인 메일 상태를 점검해야 해요. 반복 신청하지 말고 운영자에게 문의해 주세요.",
    service_unavailable: "처리 결과를 확인하지 못했어요. 메일함을 확인한 뒤 잠시 후 다시 시도해 주세요.",
    state_changed: "신청 상태가 바뀌었어요. 메일함을 확인해 주세요.",
  };
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    const data = new FormData(form);
    const button = form.querySelector('button[type="submit"]');
    if (button instanceof HTMLButtonElement && button.disabled) return;
    if (button instanceof HTMLButtonElement) button.disabled = true;
    form.setAttribute("aria-busy", "true");
    status.textContent = "확인 메일을 준비하고 있어요.";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { "content-type": "application/json", accept: "application/json" },
        body: JSON.stringify({
          email: data.get("email"),
          consent: data.get("consent") === "on",
          company: data.get("company") || "",
        }),
      });
      const body = await response.json();
      const key = typeof body.state === "string" ? body.state : typeof body.error === "string" ? body.error : "";
      const table: Record<string, string> = messages;
      status.textContent = table[key] || "신청을 처리하지 못했어요.";
      if (typeof body.devConfirmUrl === "string") {
        const link = document.createElement("a");
        link.href = body.devConfirmUrl;
        link.textContent = "이 브라우저에서만 보이는 확인 링크";
        status.append(document.createElement("br"), link);
      }
    } catch {
      status.textContent = "신청을 처리하지 못했어요.";
    } finally {
      if (button instanceof HTMLButtonElement) button.disabled = false;
      form.removeAttribute("aria-busy");
    }
  });
</script>

<style>
  .mail-points { margin: 12px 0 0; padding-left: 20px; line-height: 1.7; }
  .mail-fine { font-size: 14px; color: var(--muted, inherit); margin-top: 8px; }
  .mail-form { max-width: 560px; margin-top: 18px; }
  .mail-field { display: flex; flex-direction: column; gap: 6px; font-weight: 700; }
  .mail-field input { min-height: 44px; padding: 8px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); color: var(--ink); font: inherit; }
  .mail-check { display: flex; align-items: center; gap: 10px; min-height: 44px; margin: 12px 0; }
  .mail-check input { width: 20px; height: 20px; }
  .mail-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; }
  .mail-submit { min-height: 44px; padding: 0 18px; border: 0; border-radius: 10px; background: var(--accent); color: var(--card); font: inherit; font-weight: 700; cursor: pointer; }
  .mail-status { min-height: 44px; color: var(--muted); }
</style>
