---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RADAR_SHELVES } from "../data/radar";

const items = RADAR_SHELVES.flatMap((shelf) => shelf.items);
const total = items.length;
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "레이더 — 디자인 갤러리와 엔지니어링 선반",
  numberOfItems: total,
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.name,
    url: item.kind === "internal" ? `https://news.oiyo.net${item.url}` : item.url,
  })),
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: "https://news.oiyo.net/" },
    { "@type": "ListItem", position: 2, name: "레이더", item: "https://news.oiyo.net/radar/" },
  ],
};
---

<BaseLayout
  title="레이더 — 디자인 갤러리와 엔지니어링 선반"
  description="광고·제휴 없음. 디자인 갤러리와 엔지니어링 선반을 외부 링크와 한 줄 평으로 모아 둔 상설 페이지."
  canonical="https://news.oiyo.net/radar/"
  crumbs={[{ label: "레이더" }]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <h1>레이더</h1>
  <p class="lede">광고·제휴 없음. 디자인 갤러리와 엔지니어링 선반을 외부 링크와 한 줄 평으로 모아 둔 상설 페이지.</p>

  <nav class="radar-jump" aria-label="선반">
    {RADAR_SHELVES.map((shelf) => (
      <a href={`#${shelf.id}`}>{shelf.label}</a>
    ))}
  </nav>

  {RADAR_SHELVES.map((shelf) => (
    <section class="radar-shelf" id={shelf.id}>
      <h2>{shelf.label}</h2>
      <p class="sub">{shelf.desc}</p>
      <ol class="radar-list">
        {shelf.items.map((item) => (
          <li class="radar-item">
            {item.kind === "outbound" ? (
              <a class="radar-name" href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a>
            ) : (
              <a class="radar-name" href={item.url}>{item.name}</a>
            )}
            <p class="radar-note">{item.note}</p>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <p class="radar-foot sub">일일 속보는 <a href="/">최신 뉴스</a>, AI 서비스는 <a href="/ai/curator/">AI 큐레이터</a>.</p>
</BaseLayout>

<style>
  .radar-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    margin: 16px 0 0;
  }
  .radar-jump a {
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .radar-shelf .sub { margin-top: -4px; }
  .radar-list { margin: 0; padding-left: 24px; }
  .radar-item {
    min-height: 44px;
    margin: 0;
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
  }
  .radar-item:last-child { border-bottom-color: transparent; }
  .radar-name {
    color: var(--ink);
    font-weight: 650;
    line-height: 1.4;
    text-decoration: none;
  }
  .radar-name:visited { color: var(--muted); }
  .radar-name:hover { color: var(--accent); }
  .radar-name:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .radar-note {
    display: block;
    margin: 3px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
    max-width: 40em;
  }
  .radar-foot { margin-top: 28px; }
</style>
