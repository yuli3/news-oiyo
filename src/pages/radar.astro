---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RADAR_SHELVES } from "../data/radar";

// 레이더 선반은 통합 AI 큐레이터(/ai/curator/)로 합쳐졌다.
// 이 페이지는 URL을 살려두는 안내 포인터다 — 데이터 본체는 curator에서 렌더링한다.
const total = RADAR_SHELVES.flatMap((s) => s.items).length;
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: "https://news.oiyo.net/" },
    { "@type": "ListItem", position: 2, name: "레이더", item: "https://news.oiyo.net/radar/" },
  ],
};
---

<BaseLayout
  title="레이더 — AI 큐레이터로 통합되었습니다"
  description="디자인 갤러리·디자인 엔지니어링·글·사람·채용·에이전트 도구·공개 데이터 선반은 AI 큐레이터(/ai/curator/)로 통합되었습니다."
  canonical="https://news.oiyo.net/radar/"
  crumbs={[{ label: "레이더" }]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <span class="tag">Moved</span>
  <h1>레이더 → AI 큐레이터</h1>
  <p class="lede">
    레이더 선반 {total}개 항목은 이제 <a href="/ai/curator/">AI 큐레이터</a> 한 곳에 통합됐습니다.
    아래 섹션으로 바로 이동하세요. 일일 속보는 <a href="/">최신 뉴스</a>에 있습니다.
  </p>
  <div class="doc-grid">
    {RADAR_SHELVES.map((s) => (
      <a class="doc-link" href={`/ai/curator/#${s.id}`}>
        <strong>{s.label}</strong>
        <span>{s.desc} ({s.items.length}개)</span>
      </a>
    ))}
    <a class="doc-link" href="/ai/faq/"><strong>AI 활용 FAQ</strong><span>AX·에이전트·비용·보안 18문답</span></a>
  </div>
</BaseLayout>
