---
// 2026-09-29 2-7: 날짜별 영구 페이지(/YYYY-MM-DD/)가 57개인데 어디에서도 링크되지 않아
// 사이트맵으로만 발견되는 고아였다. 홈은 최신 항목만 페이지로 넘기고 날짜 페이지로 가는 길이 없었다.
// 날짜 목록 한 장이 모든 날짜 페이지에 인바운드 링크를 준다.
import data from "../data/news.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicDaySummary, visibleItems, type Day } from "../lib/feed";

const days = [...(data.days as Day[])].sort((a, b) => b.date.localeCompare(a.date));
const byMonth = new Map<string, Day[]>();
for (const d of days) {
  const m = d.date.slice(0, 7);
  byMonth.set(m, [...(byMonth.get(m) ?? []), d]);
}
const clip = (s: string) => (s.length > 90 ? `${s.slice(0, 90)}…` : s);
---
<BaseLayout title="날짜별 모아보기 — OIYO News" description={`${days.at(-1)?.date}부터 ${days[0]?.date}까지 하루 단위로 정리한 기술·경제 트렌드 요약 ${days.length}편.`} canonical="https://news.oiyo.net/archive/" crumbs={[{ label: "날짜별" }]}>
  <h1>날짜별 모아보기</h1>
  <p class="lede">하루치 요약과 링크를 날짜마다 한 페이지로 남겨 두었어요. 최근 날짜부터 보여요. 한 해를 한눈에 보려면 <a href="/review/2026/">2026 결산</a>을 보세요.</p>
  {/* 2026-11-22: 모든 달을 펼치면 모바일에서 12,000px였다. 최근 달만 펼치고 이전 달은 접는다(링크는 HTML에 그대로 남는다). */}
  <nav class="month-jump" aria-label="달 바로가기">{[...byMonth.keys()].map((m) => <a href={`#m-${m}`}>{Number(m.slice(5))}월</a>)}</nav>
  {[...byMonth].map(([month, list], mi) => (
    <details class="month" id={`m-${month}`} open={mi === 0}>
      <summary><h2 class="section-title">{month.replace("-", "년 ")}월 <span class="count">{list.length}일 · {list.reduce((n, d) => n + visibleItems(d.items).length, 0)}건</span></h2></summary>
      <ol class="days">
        {list.map((d) => (
          <li>
            <a href={`/${d.date}/`}><strong>{d.date}</strong> <span class="count">{visibleItems(d.items).length}건</span></a>
            {publicDaySummary(d.summary) && <p>{clip(publicDaySummary(d.summary))}</p>}
          </li>
        ))}
      </ol>
    </details>
  ))}
  <script>
    // 접힌 달로 바로 갈 때 펼친다.
    const openHash = () => { const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null; if (el instanceof HTMLDetailsElement) el.open = true; };
    window.addEventListener("hashchange", openHash);
    openHash();
  </script>
  <style>
    .month { margin-top: 8px; }
    .month summary { list-style: none; cursor: pointer; }
    .month summary::-webkit-details-marker { display: none; }
    .month summary h2 { display: flex; align-items: baseline; gap: 8px; margin: 20px 0 0; }
    .month summary h2::after { content: "+"; margin-left: auto; color: var(--muted); font-weight: 400; }
    .month[open] summary h2::after { content: "−"; }
    .month-jump { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
    .month-jump a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); color: var(--ink); text-decoration: none; font-weight: 700; font-size: 14px; }
    .month-jump a:hover { border-color: var(--accent); color: var(--accent); }
    .days { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
    .days li { padding: 10px 0; border-bottom: 1px solid var(--border); }
    .days a { text-decoration: none; }
    .count { color: var(--muted); font-size: 12px; margin-left: 6px; font-weight: 400; }
    .days p { margin: 4px 0 0; font-size: 13.5px; color: var(--muted); }
  </style>
</BaseLayout>
