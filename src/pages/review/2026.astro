---
// 2026-11-24: 연말 결산 검색 수요("2026 AI 뉴스 결산", "올해 IT 이슈")를 받는 페이지.
// news.json만으로 빌드 때 계산한다(외부 사실 추가 없음). 점수는 출처마다 척도가 달라(HN 포인트·Reddit 업보트)
// 달별 "가장 많이 본" 순위는 같은 원문을 다룬 출처 수(언급)를 먼저, 그다음 댓글 수로 정렬한다.
import data from "../../data/news.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { displayTitle, flattenFeed, hasDetailPage, isRepoItem, publicDaySummary, type Day, type FeedItem } from "../../lib/feed";
import { mentionChips, mentionCount, shortSourceLabel } from "../../lib/mentions";

const YEAR = "2026";
const days = (data.days as Day[]).filter((d) => d.date.startsWith(YEAR));
const feed = flattenFeed(days).filter((it) => !isRepoItem(it));
const repos = flattenFeed(days, { includeRepos: true }).filter((it) => isRepoItem(it));
const first = [...days].sort((a, b) => a.date.localeCompare(b.date))[0]?.date ?? "";
const last = [...days].sort((a, b) => b.date.localeCompare(a.date))[0]?.date ?? "";

const weight = (it: FeedItem) => mentionCount(mentionChips(it));
const rank = (list: FeedItem[]) =>
  [...list].sort((a, b) => weight(b) - weight(a) || (b.comments ?? 0) - (a.comments ?? 0) || (b.score ?? 0) - (a.score ?? 0));
const hrefOf = (it: FeedItem) => (hasDetailPage(it) ? `/item/${it.id}/` : it.url);
const blurb = (it: FeedItem) => {
  const s = (it.detailSummary ?? it.summary ?? "").trim();
  return s.length > 110 ? `${s.slice(0, 110)}…` : s;
};

const byMonth = new Map<string, FeedItem[]>();
for (const it of feed) byMonth.set(it.date.slice(0, 7), [...(byMonth.get(it.date.slice(0, 7)) ?? []), it]);
const months = [...byMonth.keys()].sort().reverse();
const dayCount = (m: string) => days.filter((d) => d.date.startsWith(m)).length;
const monthLead = (m: string) => {
  const d = days.filter((x) => x.date.startsWith(m) && publicDaySummary(x.summary)).sort((a, b) => b.items.length - a.items.length)[0];
  return d ? { date: d.date, text: publicDaySummary(d.summary).split(/\n/)[0].slice(0, 120) } : null;
};

const top = rank(feed).slice(0, 10);
const srcCounts = new Map<string, number>();
for (const it of feed) {
  const k = shortSourceLabel(it.src);
  srcCounts.set(k, (srcCounts.get(k) ?? 0) + 1);
}
const topSources = [...srcCounts].sort((a, b) => b[1] - a[1]).slice(0, 8);
const topRepos = [...repos].sort((a, b) => (b.score ?? 0) - (a.score ?? 0)).filter((r, i, arr) => arr.findIndex((x) => x.url === r.url) === i).slice(0, 10);

const title = `${YEAR}년 기술·AI·경제 뉴스 결산`;
const description = `${first}부터 ${last}까지 OIYO News가 정리한 ${feed.length.toLocaleString("ko-KR")}건의 기사에서 가장 많은 곳이 함께 다룬 소식 10개, 달별 화제 기사, 많이 소개된 GitHub 저장소를 모았어요.`;
---
<BaseLayout title={title} description={description} canonical={`https://news.oiyo.net/review/${YEAR}/`} crumbs={[{ label: "날짜별", href: "/archive/" }, { label: `${YEAR} 결산` }]}>
  <h1>{title}</h1>
  <p class="lede">{description}</p>
  <p class="note">순위는 같은 원문을 다룬 출처 수, 그다음 댓글 수로 정했어요. 출처마다 점수 척도가 달라 점수 자체는 비교하지 않았어요. 수집을 시작한 {first} 이전 소식은 없어요.</p>

  <dl class="stats">
    <div><dt>정리한 날</dt><dd>{days.length}일</dd></div>
    <div><dt>기사</dt><dd>{feed.length.toLocaleString("ko-KR")}건</dd></div>
    <div><dt>소개한 저장소</dt><dd>{repos.length}건</dd></div>
  </dl>

  <h2 class="section-title">올해 가장 많이 다룬 소식 10</h2>
  <ol class="rank">
    {top.map((it) => (
      <li>
        <a href={hrefOf(it)}>{displayTitle(it)}</a>
        <span class="meta">{it.date} · {shortSourceLabel(it.src)}{weight(it) > 1 ? ` 외 ${weight(it) - 1}곳` : ""}{it.comments ? ` · 댓글 ${it.comments.toLocaleString("ko-KR")}` : ""}</span>
        {blurb(it) && <p>{blurb(it)}</p>}
      </li>
    ))}
  </ol>

  <h2 class="section-title">달별 화제</h2>
  <nav class="month-jump" aria-label="달 바로가기">{months.map((m) => <a href={`#m-${m}`}>{Number(m.slice(5))}월</a>)}</nav>
  {months.map((m) => {
    const lead = monthLead(m);
    return (
      <section class="month" id={`m-${m}`}>
        <h3>{Number(m.slice(5))}월 <span class="count">{dayCount(m)}일 · {byMonth.get(m)!.length}건</span></h3>
        {lead && <p class="lead">가장 기사가 많던 날 <a href={`/${lead.date}/`}>{lead.date}</a>: {lead.text}</p>}
        <ol class="rank small">
          {rank(byMonth.get(m)!).slice(0, 5).map((it) => (
            <li><a href={hrefOf(it)}>{displayTitle(it)}</a> <span class="meta">{it.date.slice(5)} · {shortSourceLabel(it.src)}</span></li>
          ))}
        </ol>
      </section>
    );
  })}

  <h2 class="section-title">많이 소개한 GitHub 저장소</h2>
  <ol class="rank small">
    {topRepos.map((r) => <li><a href={r.url} rel="noopener">{r.title}</a> <span class="meta">{r.date}{r.score ? ` · ★ ${r.score.toLocaleString("ko-KR")}` : ""}</span></li>)}
  </ol>

  <h2 class="section-title">어디서 모았나</h2>
  <ul class="sources">{topSources.map(([s, n]) => <li>{s} <span class="count">{n.toLocaleString("ko-KR")}건</span></li>)}</ul>
  <p class="more">날짜별 전체 기사는 <a href="/archive/">날짜별 모아보기</a>에서 볼 수 있어요.</p>

  <style>
    .note { font-size: 13px; color: var(--muted); }
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 16px 0; }
    .stats div { border: 1px solid var(--border); border-radius: 12px; padding: 12px; background: var(--card); }
    .stats dt { font-size: 12px; color: var(--muted); }
    .stats dd { margin: 4px 0 0; font-size: 20px; font-weight: 800; }
    .rank { margin: 8px 0 0; padding-left: 22px; }
    .rank li { padding: 8px 0; border-bottom: 1px solid var(--border); }
    .rank a { font-weight: 700; text-decoration: none; overflow-wrap: anywhere; }
    .rank p { margin: 4px 0 0; font-size: 13.5px; color: var(--muted); }
    .rank.small li { padding: 6px 0; }
    .rank.small a { font-weight: 600; }
    .meta, .count { color: var(--muted); font-size: 12px; font-weight: 400; display: inline-block; margin-left: 4px; }
    .month h3 { margin: 20px 0 4px; }
    .lead { font-size: 13.5px; margin: 0; }
    .month-jump { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
    .month-jump a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); color: var(--ink); text-decoration: none; font-weight: 700; font-size: 14px; }
    .sources { display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 0; list-style: none; }
  </style>
</BaseLayout>
