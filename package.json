{
  "name": "news-oiyo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-mailing-news.mjs && astro build",
    "type-check": "astro check",
    "lint": "npm run type-check && npm run lint:shadcn",
    "lint:shadcn": "eslint --pass-on-unpruned-suppressions src",
    "lint:shadcn:prune": "eslint --prune-suppressions src",
    "preview": "astro preview",
    "collect": "node scripts/collect-news.mjs",
    "collect:market": "node scripts/collect-market.mjs",
    "audit:trends": "node scripts/audit-trend-notes.mjs",
    "sync": "node scripts/sync-news.mjs",
    "update": "npm run collect && npm run collect:market && npm run audit:trends && npm run sync",
    "audit:headers-collision": "node scripts/audit-headers-collision.mjs",
    "audit:details": "node scripts/audit-detail-pages.mjs",
    "details:pending": "node scripts/list-pending-details.mjs",
    "details:apply": "node scripts/apply-detail-summaries.mjs",
    "mailing-list:dev": "node scripts/mailing-list-dev.mjs",
    "test:mailing-list": "node --test scripts/test/mailing-list*.test.mjs",
    "test:story-scope": "node --test scripts/test/story-scope.test.mjs",
    "mailing-list:digest": "node scripts/render-mailing-digest.mjs",
    "translations:pending": "node scripts/translations-pending.mjs",
    "translations:check": "node scripts/check-translations.mjs",
    "showcase:sync": "node scripts/sync-showcase-weekly.mjs",
    "video:briefing": "node scripts/generate-daily-video-briefing.mjs",
    "video:render": "node scripts/render-daily-video.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@shadcn/lint": "^0.2.0",
    "@typescript-eslint/parser": "^8.71.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3"
  }
}
